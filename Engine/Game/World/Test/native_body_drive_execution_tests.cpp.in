#include "Extension/World/native_body_drive.h"
#include "Engine/Game/Build/20260929/engine.h"
#include "Engine/Game/Build/20260929/rigid_bodies.h"
#include "Engine/Game/Build/20260929/remote_collision.h"
#include <cstdlib>
#include <cstring>
#include <iostream>
#include <map>
#include <vector>

namespace dingosdk::body_drive {
namespace {
namespace addr=game::build::v20260929;
namespace r=addr::rigid_bodies;
namespace c=addr::remote_collision;
constexpr std::uintptr_t fixture_base=0x100000000,fixture_client=0x20000,tls_table=0x30000,fixture_tls=0x40000;
constexpr World live{0x50000,0x60000,0x70000};
constexpr NativeHandle driven{live.world,8,31},anchor{live.world,9,41},joint{live.world,10,51};
constexpr Pose fixture_pose{0,0,0,1,1,2,3,1};
std::map<std::uintptr_t,std::vector<unsigned char>> bytes;
std::uint32_t worker=772;
unsigned targets{},removals{},allocations{};
bool recurse{},nested_result{},fail_target{},world_available=true;
NativeDrive* adapter{};
World observed=live;
void require(bool ok,const char* reason) {
    if(!ok){std::cerr<<reason<<'\n';std::exit(1);}
}
template<class T>void put(std::uintptr_t at,T value) {
    auto& data=bytes[at];data.resize(sizeof(value));std::memcpy(data.data(),&value,sizeof(value));
}
namespace memory {
template<class T>bool peek(std::uintptr_t at,T& value) {
    auto it=bytes.find(at);if(it==bytes.end()||it->second.size()!=sizeof(value))return false;
    std::memcpy(&value,it->second.data(),sizeof(value));return true;
}
}
bool pointer(std::uintptr_t p){return p>=0x10000&&p<0x10000000000;}
std::uint32_t GetCurrentThreadId(){return worker;}
std::uint64_t __readgsqword(unsigned offset){require(offset==0x58,"wrong TLS slot");return tls_table;}
using GetWorld=std::uintptr_t (*)(std::uintptr_t);
bool native_world(GetWorld fn,std::uintptr_t context,std::uintptr_t& world) {
    require(reinterpret_cast<std::uintptr_t>(fn)==fixture_base+c::physics_world.rva&&context==live.context,"wrong world lookup");
    world=observed.world;return world_available;
}
@native_drive_operation@
}
@native_drive_capture@
@native_drive_execution@

bool NativeDrive::resolve() noexcept{return true;}
bool NativeDrive::valid_pose(const Pose& value)const noexcept{return value==fixture_pose;}
bool NativeDrive::body_valid(NativeHandle h)const noexcept{return current(live)&&(h==driven||h==anchor);}
bool NativeDrive::joint_valid(NativeHandle h)const noexcept{return current(live)&&h==joint;}
bool NativeDrive::create_anchor(World w,const Pose&,NativeHandle& out)noexcept {
    require(w==live,"wrong anchor world");++allocations;out=anchor;return true;
}
bool NativeDrive::create_joint(World w,NativeHandle b,NativeHandle a,NativeHandle& out)noexcept {
    require(w==live&&b==driven&&a==anchor,"wrong joint ownership");out=joint;return true;
}
bool NativeDrive::enable(NativeHandle h)noexcept{return h==joint;}
bool NativeDrive::target(NativeHandle h,const Pose& value)noexcept {
    require(h==anchor&&value==fixture_pose,"target must use exact owned helper");++targets;
    if(recurse){recurse=false;nested_result=adapter->update(driven,fixture_pose);}
    return !fail_target;
}
bool NativeDrive::remove_joint(World w,NativeHandle& h)noexcept {
    require(current(w)&&h==joint,"invalid joint cleanup");++removals;h={};return true;
}
bool NativeDrive::remove_anchor(World w,NativeHandle& h)noexcept {
    require(current(w)&&h==anchor,"invalid anchor cleanup");++removals;h={};return true;
}
void reset() {
    bytes.clear();targets=removals=allocations=0;worker=772;observed=live;
    recurse=nested_result=fail_target=false;world_available=true;
    put(fixture_client,fixture_base+addr::engine::client_vtable);put(fixture_client+r::client_context,live.context);
    put(fixture_client+r::client_phase,std::uint32_t{13});put(fixture_base+addr::engine::tls_index,std::uint32_t{2});
    put(tls_table+2*sizeof(std::uintptr_t),fixture_tls);put(fixture_tls+r::tls_active,std::uint8_t{1});
    put(fixture_tls+r::tls_context,live.context);put(live.world+addr::physics_bodies::store_offset,live.state);
}
void run() {
    reset();NativeDrive drive;adapter=&drive;
    require(drive.start(fixture_base,fixture_client,driven,fixture_pose),"first worker must acquire lease");
    worker=784;
    require(drive.update(driven,fixture_pose)&&targets==1,"next qualified physics worker must update the existing lease");
    recurse=true;
    require(drive.update(driven,fixture_pose)&&!nested_result&&targets==2,"overlapping operation must be refused before native target");
    for(unsigned fault=0;fault<8;++fault){
        reset();adapter=&drive;worker=800+fault;
        switch(fault){
            case 0:put(fixture_tls+r::tls_active,std::uint8_t{0});break;
            case 1:put(fixture_tls+r::tls_context,std::uintptr_t{0x90000});break;
            case 2:put(fixture_client+r::client_phase,std::uint32_t{12});break;
            case 3:put(fixture_client,fixture_base+addr::engine::client_vtable+8);break;
            case 4:put(fixture_base+addr::engine::tls_index,std::uint32_t{4096});break;
            case 5:bytes.erase(tls_table+2*sizeof(std::uintptr_t));break;
            case 6:world_available=false;break;
            case 7:put(live.world+addr::physics_bodies::store_offset,std::uintptr_t{0});break;
        }
        require(!drive.update(driven,fixture_pose)&&targets==0,"unqualified worker must make no target call");
        require(!drive.stop()&&removals==0,"unqualified worker must make no cleanup call");
    }
    reset();worker=900;
    require(drive.stop()&&removals==2&&!drive.occupied(),"qualified replacement worker must clean up in order");
    reset();NativeDrive migrated;adapter=&migrated;
    require(migrated.start(fixture_base,fixture_client,driven,fixture_pose),"acquire before world replacement");
    observed.world=0x80000;put(observed.world+addr::physics_bodies::store_offset,live.state);
    require(!migrated.update(driven,fixture_pose)&&targets==0&&migrated.uncertain(),"world replacement must quarantine old lease");
    observed=live;
    require(!migrated.stop()&&removals==0,"recycled old world must not restore authority");
    reset();NativeDrive failed;adapter=&failed;
    require(failed.start(fixture_base,fixture_client,driven,fixture_pose),"acquire before target failure");
    worker=784;fail_target=true;
    require(!failed.update(driven,fixture_pose)&&targets==1,"native target failure must propagate");
    fail_target=false;
    require(!failed.update(driven,fixture_pose)&&targets==1,"uncertain target must not be retried");
    worker=900;
    require(failed.stop()&&removals==2,"uncertain lease must permit ordered cleanup by qualified worker");
    std::cout<<"native drive worker migration, serialization and TLS/world regressions passed\n";
}
}
int main(){dingosdk::body_drive::run();}
