inline WriterProbe retained_writer_probe(){return retained;}
inline void retained_writer_event(const WriterProbe& probe,unsigned stage,const char*,std::uint32_t,bool,std::uintptr_t core){
 if(probe.contact&&core==probe.native.owner.core)retained_phases.push_back(stage);
}
