   case 3:held_value.native.owner.rig=99;break;case 4:ground_state.initialized=false;break;
   case 5:ground_state.velocity_guard_active=false;break;case 6:ground_state.busy.test_and_set();break;
   case 7:state_id=201;break;case 8:allow_target=false;break;case 9:state_id=504;break;
  }
