 fixture_hold.command.after={-1.992847f,12.7f,4.9508963f};wallplant_hold_core.store(1);fixture_state.busy.clear();
 fixture_state.initialized=true;fixture_state.velocity_guard_active=true;fixture_state.trial.debug={};fixture_now=260;authority_reads=0;
 enabled=current_owner=current_authority=verified=true;session=teleport=pending=false;fixture_selected=100;
