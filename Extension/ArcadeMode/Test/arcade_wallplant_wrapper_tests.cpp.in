@wallplant_wrapper_handoff@
void arcade_wallplant_after_reconstruction(const WallplantHandoff& staged,std::uintptr_t core) noexcept {
 if(!staged.ticket.selected || staged.execution.native.owner.core!=core)return;
 ++writes;event("final_write",core);
 if(begin_hold_on_write)wallplant_hold_core.store(core);
}
void arcade_wallplant_hold_step(std::uintptr_t core) noexcept {
 if(wallplant_hold_core.load()!=core)return;
 event("hold_step",core);
 if(release_hold){wallplant_hold_core.store(0);++hold_releases;event("hold_release",core);}
}
