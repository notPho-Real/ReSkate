// Production-composed chooser/velocity wrapper seam. These stubs observe call
// ownership/order only; they are not a physics or hardware acceptance model.
#include "Extension/ArcadeMode/arcade_wallplant.h"
#include <atomic>
#include <cstdlib>
#include <iostream>
#include <string>
#include <thread>
#include <utility>
#include <vector>
namespace dingosdk::arcade_mode::wallplant_runtime {
struct WriterProbe { std::uint64_t input{},contact{},raw{}; NativeInputFrame native{}; };
inline WriterProbe writer_probe(){return {};}
inline void writer_event(const WriterProbe&,unsigned,const char*,std::uint32_t,bool,std::uintptr_t){}
inline WriterProbe retained;
inline std::vector<unsigned> retained_phases;
inline WriterProbe retained_writer_probe(){return retained;}
inline void retained_writer_event(const WriterProbe& probe,unsigned stage,const char*,std::uint32_t,bool,std::uintptr_t core){
 if(probe.contact&&core==probe.native.owner.core)retained_phases.push_back(stage);
}
}
namespace {
namespace arcade_mode=dingosdk::arcade_mode;
unsigned checks{};
void check(bool ok,const char* message){++checks;if(!ok){std::cerr<<"wrapper: "<<message<<'\n';std::exit(1);}}
struct Event { std::string name;std::uintptr_t core;bool active; };
std::vector<Event> events;
void event(const char* name,std::uintptr_t core=0,bool active=false){events.push_back({name,core,active});}
std::uint32_t native_result=100;
unsigned native_calls{},chooser_calls{},writes{},hold_releases{};
std::atomic<std::uintptr_t> wallplant_hold_core{};
bool release_hold{},begin_hold_on_write{};
bool reenter{},admit=true;
std::uint64_t serial{};
struct SourceLastError { SourceLastError(){} };
struct LastError { LastError(){} };
struct SourceReader { bool raw(std::uintptr_t,void* target,std::size_t){*static_cast<std::uint32_t*>(target)=native_result;return true;} };
namespace memory {template<class T>bool peek(std::uintptr_t,T& value){value=9;return true;}}
namespace game::build::v20260929::arcade_native_probe { constexpr std::uintptr_t selected_state=0,core_selector=0x440; }
struct NativeState { std::atomic<void(*)(std::uintptr_t)> velocity_update_original{}; } native_state;
NativeState& source_state(){return native_state;}
std::atomic<void(*)()> physics_step_callback{};
void noclip_physics_update(std::uintptr_t);
void native_update(std::uintptr_t core){
 ++native_calls;event("native",core);
 if(reenter){reenter=false;noclip_physics_update(core);}
}
#define ORDINARY(name) void name(std::uintptr_t core){event(#name,core);}
ORDINARY(noclip_apply_velocity) ORDINARY(trainer_apply_jump_scale)
ORDINARY(trainer_push_speed) ORDINARY(apply_push_velocity) ORDINARY(apply_plugin_velocity)
ORDINARY(trainer_pump_power) ORDINARY(trainer_air_gravity) ORDINARY(trainer_revert_boost)
ORDINARY(trainer_transition)
#undef ORDINARY
void callback(){event("callback");}
void arcade_air_apply(std::uintptr_t core,bool active){event("arcade_air_apply",core,active);}
@wallplant_wrapper_handoff@
void arcade_wallplant_after_reconstruction(const WallplantHandoff& staged,std::uintptr_t core) noexcept {
 if(!staged.ticket.selected || staged.execution.native.owner.core!=core)return;
 ++writes;event("final_write",core);
 if(begin_hold_on_write)wallplant_hold_core.store(core);
}
void arcade_wallplant_hold_step(std::uintptr_t core) noexcept {
 if(wallplant_hold_core.load()!=core)return;
 event("hold_step",core);
 if(release_hold){wallplant_hold_core.store(0);++hold_releases;event("hold_release",core);}
}
@wallplant_wrapper_transform_validation@
@wallplant_wrapper_target@
std::uint64_t apply_arcade_wallplant_before_selection(std::uintptr_t selector,std::uint32_t current) noexcept {
 event("prepare",selector);
 if(!admit)return 0;
 auto& staged=wallplant_handoff();staged={};
 staged.execution.native.owner.core=1;
 staged.ticket={++serial,7,selector,current,0,false};
 return serial;
}
@wallplant_wrapper_finish@
struct Owner { std::uintptr_t selector{}; };
struct Wanted {std::atomic<std::uint64_t> until{};std::atomic<float> magnitude{};} wanted_value;
Wanted& wanted_wipeout(){return wanted_value;}
struct Watch {
 std::atomic<std::uintptr_t> selector{},causes{};
 std::atomic<std::uint64_t> until{},since{};
 std::atomic<std::uint32_t> state{},previous{},changes{},wipeouts{};
 std::atomic<long long> previous_ticks{};
} watch;
Watch& state_watch(){return watch;}
constexpr std::uint32_t wipeout_physics_state=504;
constexpr unsigned wanted_wipeout_reason=1;
std::uint64_t GetTickCount64(){return 100;}
bool protected_owner(std::uintptr_t,std::uintptr_t Owner::*){return false;}
void record_cause(std::uintptr_t,unsigned,float){}
void hold_off_board(std::uintptr_t,std::uint32_t){}
std::pair<std::uint64_t,bool> take_balance_bail(std::uintptr_t,std::uint32_t){return {};}
void dark_pop_before(std::uintptr_t,std::uint32_t){}
bool filter_requests(std::uintptr_t,std::uintptr_t Owner::*){return false;}
std::uint32_t original_choose(std::uintptr_t selector,std::uint32_t){
 ++chooser_calls;event("choose_original",selector);return native_result;
}
struct Protection {
 std::uint32_t (*choose_original)(std::uintptr_t,std::uint32_t)=original_choose;
 int lock{};struct Balance{void finish(std::uint64_t,bool,std::uint32_t){}} balance_bail;
} protection_value;
Protection& protection(){return protection_value;}
void AcquireSRWLockExclusive(int*){}
void ReleaseSRWLockExclusive(int*){}
namespace logging {enum class Level{debug};enum class Channel{skater};template<class... T>void log(Level,Channel,const char*,T...){}}
std::uint32_t dark_pop_after(std::uintptr_t,std::uint32_t,std::uint32_t value){return value;}
void fast_probe_record(std::uintptr_t,std::uint32_t,std::uint32_t,std::uint32_t){}
struct LARGE_INTEGER{long long QuadPart{};};
void QueryPerformanceCounter(LARGE_INTEGER* value){value->QuadPart=1000;}
namespace skater_events {void note_wipeout(std::uintptr_t){}}
void track_spin(std::uintptr_t selector,std::uint32_t){event("track_spin",selector);}
@wallplant_wrapper_choose@
@wallplant_wrapper_physics@
void reset(){
 events.clear();wallplant_handoff()={};native_calls=chooser_calls=writes=0;
 arcade_mode::wallplant_runtime::retained={};arcade_mode::wallplant_runtime::retained_phases.clear();
 native_result=100;reenter=false;admit=true;
 wallplant_hold_core.store(0);hold_releases=0;release_hold=begin_hold_on_write=false;
 native_state.velocity_update_original.store(native_update);
 physics_step_callback.store(callback);
}
std::size_t find(const char* name,std::size_t start=0){
 for(std::size_t i=start;i<events.size();++i)if(events[i].name==name)return i;
 return events.size();
}
void run(){
 {
  reset();
  auto& scope=arcade_mode::wallplant_runtime::retained;
  auto& phases=arcade_mode::wallplant_runtime::retained_phases;
  wallplant_selection_phase(9,201,0,"before_selection");
  check(phases.empty(),"ordinary selector has no retained-contact diagnostic");
  scope.contact=1;scope.raw=2;scope.native.owner.core=1;scope.native.owner.context=3;
  wallplant_selection_phase(8,201,0,"foreign");
  check(phases.empty(),"foreign selector cannot consume retained diagnostic stages");
  wallplant_selection_phase(9,201,0,"before_selection");
  check(choose_state(9,201)==100,"diagnostic scope does not alter native selection");
  noclip_physics_update(2);
  check(phases==std::vector<unsigned>{0,1},"foreign core adds no retained phase observations");
  noclip_physics_update(1);
  check(phases==std::vector<unsigned>{0,1,2,3,4},"actual chooser and wrapper expose every original boundary even without pending input");
  check(scope.input==0&&writes==1&&chooser_calls==1&&native_calls==2,
        "diagnostic-only snapshot grants no extra command, native call or body write");
 }
 for(auto result:{100u,201u,504u}){
  reset();native_result=result;
  check(choose_state(9,201)==result,"chooser result is not replaced by wallplant");
  check(chooser_calls==1,"original chooser called once");
  check(find("prepare")<find("choose_original") && find("choose_original")<find("track_spin"),"ticket surrounds native selection");
  check(wallplant_handoff().ticket.selected==(result!=504),"only accepted original result arms handoff");
  noclip_physics_update(1);
  check(native_calls==1,"native reconstruction called once");
  check(writes==(result!=504?1u:0u),"cancelled selection cannot write");
  if(result!=504){
   const auto final=find("final_write");
   for(const char* name:{"native","noclip_apply_velocity","trainer_apply_jump_scale","callback","trainer_push_speed","arcade_air_apply","apply_push_velocity","apply_plugin_velocity","trainer_pump_power","trainer_air_gravity","trainer_revert_boost","trainer_transition"})
    check(find(name)<final,"final write follows native and every ordinary writer");
   check(events[find("arcade_air_apply")].active,"ordinary writer sees already-owned pending input");
   check(final+1==events.size(),"no later wrapper writer overwrites rebound");
  }
  noclip_physics_update(1);check(writes==(result!=504?1u:0u),"handoff is one-use");
 }
 reset();choose_state(9,201);const auto ticket=wallplant_handoff().ticket.invocation;
 noclip_physics_update(2);
 check(wallplant_handoff().ticket.invocation==ticket && writes==0,"foreign core cannot steal handoff");
 check(!events[find("arcade_air_apply")].active,"foreign core ordinary ownership unchanged");
 noclip_physics_update(1);check(writes==1,"right owner consumes after foreign callback");
 reset();choose_state(9,201);reenter=true;noclip_physics_update(1);
 check(native_calls==2 && writes==1,"nested native callback cannot duplicate handoff");
 unsigned active{};for(const auto& e:events)if(e.name=="arcade_air_apply"&&e.active)++active;
 check(active==1 && find("final_write")+1==events.size(),"nested callback cannot steal final ownership");
 reset();choose_state(9,201);
 std::thread other([]{noclip_physics_update(1);});other.join();
 check(writes==0 && wallplant_handoff().ticket.selected,"foreign thread cannot take local ticket");
 noclip_physics_update(1);check(writes==1,"originating thread retains single handoff");
 reset();admit=false;choose_state(9,201);noclip_physics_update(1);check(writes==0,"unadmitted selection cannot write");
 reset();choose_state(9,201);const auto call=wallplant_handoff().ticket.invocation;
 finish_arcade_wallplant_selection(call+1,9,201,100);noclip_physics_update(1);check(writes==0,"mismatched invocation cancels");
 reset();choose_state(9,201);finish_arcade_wallplant_selection(wallplant_handoff().ticket.invocation,10,201,100);
 noclip_physics_update(1);check(writes==0,"mismatched selector cancels");
 {
  reset();admit=false;wallplant_hold_core.store(1);
  check(choose_state(9,201)==100&&chooser_calls==1,"active hold never replaces original chooser result");
  noclip_physics_update(1);
  check(native_calls==1&&writes==0&&hold_releases==0,"active hold preserves native update without another entry or release write");
  check(find("native")<find("callback")&&find("callback")<find("hold_step"),
        "native physics and callback precede bounded hold processing");
  for(const char* name:{"noclip_apply_velocity","trainer_apply_jump_scale","trainer_push_speed","arcade_air_apply",
      "apply_push_velocity","apply_plugin_velocity","trainer_pump_power","trainer_air_gravity","trainer_revert_boost","trainer_transition"})
   check(find(name)==events.size(),"active owner prevents competing SDK velocity writers");
  events.clear();release_hold=true;noclip_physics_update(1);
  check(native_calls==2&&hold_releases==1&&find("hold_release")+1==events.size(),"single hold release is last after unchanged native update");
  events.clear();noclip_physics_update(1);
  check(native_calls==3&&hold_releases==1&&find("arcade_air_apply")<events.size(),
        "released owner returns to ordinary writers without replaying release");
 }
 {
  reset();wallplant_hold_core.store(1);noclip_physics_update(2);
  check(native_calls==1&&find("arcade_air_apply")<events.size()&&find("hold_step")==events.size(),
        "foreign core retains ordinary physics and cannot process another owner's hold");
  check(wallplant_hold_core.load()==1,"foreign core leaves hold ownership intact");
 }
 {
  reset();wallplant_hold_core.store(1);reenter=true;noclip_physics_update(1);
  check(native_calls==2&&writes==0&&hold_releases==0,"reentrant native physics cannot create an entry or early release");
  release_hold=true;events.clear();noclip_physics_update(1);
  check(hold_releases==1&&find("hold_release")+1==events.size(),"reentry history cannot duplicate final release");
 }
 {
  reset();choose_state(9,201);begin_hold_on_write=true;noclip_physics_update(1);
  check(writes==1&&wallplant_hold_core.load()==1&&find("final_write")<find("hold_step"),
        "newly owned hold is processed only after its single final entry transaction");
  check(hold_releases==0,"same callback does not imply elapsed160ms");
 }
 {
  arcade_mode::WallplantCommand command;command.anchor_verified=true;
  command.anchor={7,8,9};command.hold_forward={1,0,0};
  const std::array<float,16> supplied{1,0,0,11,0,.8f,.6f,12,0,-.6f,.8f,13,2,3,4,1};
  std::array<float,16> target{};
  check(wallplant_hold_target_matrix(command,supplied,target),"actual target helper accepts measured orthonormal pitched basis");
  for(unsigned axis=0;axis<3;++axis){
   check(target[4+axis]==supplied[4+axis],"local up/pitch-roll basis remains unchanged");
   check(std::abs(target[8+axis]-supplied[axis])<.00001f,"target forward follows exact local-yaw projection");
   check(target[12+axis]==command.anchor[axis],"only supplied verified anchor sets target translation");
  }
  for(unsigned lane:{3u,7u,11u,15u})check(target[lane]==supplied[lane],"native fourth lanes unchanged");
  check(supplied[12]==2&&supplied[13]==3&&supplied[14]==4,"input matrix remains immutable");
  for(unsigned fault=0;fault<5;++fault){
   auto bad=command;auto matrix=supplied;target.fill(123);
   switch(fault){
   case 0:bad.anchor_verified=false;break;
   case 1:bad.anchor[0]=std::numeric_limits<float>::infinity();break;
   case 2:bad.hold_forward={0,0,0};break;
   case 3:bad.hold_forward[0]=std::numeric_limits<float>::quiet_NaN();break;
   case 4:matrix[0]=2;break;
   }
   check(!wallplant_hold_target_matrix(bad,matrix,target),"unverified anchor/invalid orientation cannot emit target");
   check(target[0]==123&&target[12]==123,"failed target admission leaves caller output unchanged");
  }
 }
 std::cout<<checks<<" production wrapper ordering checks passed\n";
}
}
void run_wallplant_wrapper_tests(){run();}
#ifdef ARCADE_WALLPLANT_WRAPPER_STANDALONE
int main(){run_wallplant_wrapper_tests();}
#endif
