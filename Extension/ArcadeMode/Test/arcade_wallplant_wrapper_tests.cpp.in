    watched_orientation.local_root==orientation_snapshot.local_root && watched_orientation.limit==orientation_snapshot.limit &&
    watched_orientation.root_spin==orientation_snapshot.root_spin && watched_orientation.reference_spin==orientation_snapshot.reference_spin),
