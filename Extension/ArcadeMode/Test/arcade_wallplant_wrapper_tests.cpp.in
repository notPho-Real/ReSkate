  object[native::query_pending]=1;after_selection=pending_after;selections=0;
  const auto result=consume_ready_native_trajectory(base,trajectory);
  check(result==(pending_after==0) && selections==1,"completed, unfinished or renewed queries are handled by one native call");
  check(object[native::query_pending]==pending_after,"helper never manufactures a completed query");
