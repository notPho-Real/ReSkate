  wallplant_read_current_intent(intent,earlier,7);
  check(earlier-intent.sampled_at==150,"existing inclusive input lease remains unchanged");
 }
 for(unsigned fault=0;fault<7;++fault){
  reset();auto earlier=fixture_now;arcade_mode::AirMotionIntent intent;
