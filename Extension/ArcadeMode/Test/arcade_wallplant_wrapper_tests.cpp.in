void shape(std::uintptr_t at){
 ++shapes;put(at,{-1.1069391f,13.73243f,.27464858f});
 // Model a native side effect, independent of the velocity field.
 *reinterpret_cast<unsigned char*>(at+native::reference_velocity+16)=73;
}
void setter(std::uintptr_t at,float* parameters){
 ++sets;
 if(fail_set)throw 1;
 std::copy_n(parameters,submitted_packet.values.size(),submitted_packet.values.begin());
 std::memcpy(reinterpret_cast<void*>(at+native::requested_velocity),
     parameters+native::parameter_velocity/sizeof(float),16);
 std::memcpy(reinterpret_cast<void*>(at+native::reference_velocity),
     parameters+native::parameter_reference_velocity/sizeof(float),16);
 std::copy_n(parameters+native::parameter_reference_velocity/sizeof(float),3,submitted_reference.begin());
 if(nested){
  NativeTrajectoryParameters p;
  check(!world_trajectory_route::submit_native_trajectory(hook.base,at,p,true),"recursive submission cannot acquire the same scope");
  shape_launch_hook(reinterpret_cast<std::uintptr_t>(other.data()));
 }
 if(!skip_shape)shape_launch_hook(at);
 candidate_velocity=get(at); // What the native query receives after shaping.
 std::memcpy(candidate_reference.data(),reinterpret_cast<void*>(at+native::reference_velocity),sizeof(candidate_reference));
 object[native::query_pending]=1; // Pending collision work remains genuine.
}
unsigned offers{},completions{};
bool allow_offer{},offer_spent{},submission{};
std::array<float,3> offered_velocity{};
bool bridge(std::uintptr_t at,NativeWorldTrajectoryOverride& request,bool completed) noexcept {
 if(completed){++completions;submission=request.submitted;return request.receipt==9;}
 ++offers;
 check(request.caller==native::pop_query_call.rva,"bridge receives the original call site before granting authority");
 if(!allow_offer || offer_spent || at!=reinterpret_cast<std::uintptr_t>(object.data()))return false;
 offer_spent=true;request.receipt=9;request.velocity=offered_velocity;return true;
}
void run(){
 const auto base=reinterpret_cast<std::uintptr_t>(&select)-native::select_result.rva;
 const auto at=reinterpret_cast<std::uintptr_t>(object.data());
 const std::array<float,3> exit{-2.285966f,12.7f,4.967785f};
 NativeTrajectoryParameters p;std::copy(exit.begin(),exit.end(),p.values.begin()+32);
 const std::array<float,3> held_velocity{.22170794f,-.6215819f,.6f};
 std::copy(held_velocity.begin(),held_velocity.end(),p.values.begin()+36);
 p.values[35]=17;p.values[39]=23;p.values[40]=31;
 reinterpret_cast<unsigned char*>(p.values.data())[native::parameter_launch]=1;
 hook.base=base;hook.original.store(&setter);hook.shape_original.store(&shape);
 for(bool preserve:{false,true}){
  object.fill(0);sets=shapes=selections=0;
  check(world_trajectory_route::submit_native_trajectory(base,at,p,preserve),"one valid request submits once");
  check(sets==1&&shapes==1&&selections==1,"native setter shaping and selection each execute once");
  check(candidate_velocity==(preserve?exit:std::array<float,3>{-1.1069391f,13.73243f,.27464858f}),"world exit reaches collision generation; ordinary launches keep native shaping");
  check(candidate_reference==(preserve?exit:held_velocity)&&submitted_reference==candidate_reference,"explicit exits supply matching reference speed before shaping and candidate generation");
  check(p.values[36]==held_velocity[0]&&p.values[39]==23,"submission leaves the caller's observed packet intact");
  check(object[native::reference_velocity+16]==73&&object[native::query_pending]==1,"classification and pending collision query are not fabricated or cleared");
  check(submitted_packet.values[35]==17&&submitted_packet.values[39]==23&&submitted_packet.values[40]==31,"paired velocity update preserves native homogeneous components and other packet fields");
  check(!world_trajectory_request.object,"permission ends before later selection or physics");
 }
 object.fill(0);nested=true;shapes=sets=selections=0;
 check(world_trajectory_route::submit_native_trajectory(base,at,p,true)&&sets==1&&shapes==2,"scoped request cannot leak into another native object");
 check(get(reinterpret_cast<std::uintptr_t>(other.data()))!=exit,"other object's native launch remains unchanged");nested=false;
 shape_launch_hook(at);check(get(at)!=exit,"later callbacks do not repeat the override");
 for(unsigned bad=0;bad<7;++bad){
  object.fill(0);sets=shapes=selections=0;valid_code=true;fail_set=false;skip_shape=false;
  hook.shape_original.store(&shape);auto parameters=p;
  if(bad==0)object[native::query_pending]=1;
  if(bad==1)valid_code=false;
  if(bad==2)hook.shape_original.store(nullptr);
  if(bad==3)parameters.values[32]=std::numeric_limits<float>::quiet_NaN();
  if(bad==4)parameters.values[34]=1000;
  if(bad==5)fail_set=true;
  if(bad==6)skip_shape=true;
  check(!world_trajectory_route::submit_native_trajectory(base,at,parameters,true),"busy, unknown, invalid or unobserved native submissions fail closed");
  check(!world_trajectory_request.object&&selections==0,"failure clears synchronous permission without another selector or impulse");
  if(bad<5)check(sets==0,"invalid submission does not reach the native setter");
 }
 fail_set=skip_shape=false;
 world_trajectory_request={at,exit,false,false,{}};
 std::thread other_thread([&]{
  check(!world_trajectory_request.object,"world-space permission is confined to the submitting thread");
  shape_launch_hook(at);
 });other_thread.join();
 check(!world_trajectory_request.observed&&get(at)!=exit,"another native thread cannot spend or inherit the request");
 world_trajectory_request={};
 hook.shape_original.store(&shape);valid_code=true;hook.world_bridge.store(&bridge);
 for(unsigned scenario=0;scenario<7;++scenario){
  object.fill(0);offers=completions=sets=shapes=selections=0;offer_spent=false;submission=false;
  allow_offer=scenario!=0;offered_velocity=exit;skip_shape=scenario==4;fail_set=scenario==5;
  auto packet=p;packet.values[32]=.3728471f;packet.values[33]=-.775009f;packet.values[34]=.6f;
  const auto original_packet=packet;
  if(scenario==1)object[native::query_pending]=1;
