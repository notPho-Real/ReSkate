 std::array<std::uint32_t,2> pending{0,8};
 bool stale{};unsigned verified{};
 template<class T>T value(std::uintptr_t part,std::uintptr_t offset) {
  check(part==100 || part==800,"physical reader uses only owned root and reference body");
  const unsigned i=part==100?0:1;
  if constexpr(std::is_same_v<T,std::array<float,4>>) {
   const auto row=(offset-addr::skater_body::body_transform_offset)/16;
   check(row<4 && offset==addr::skater_body::body_transform_offset+row*16,
         "physical position comes from bounded native body transform rows");
   T result;std::copy_n(transforms[i].begin()+row*4,4,result.begin());return result;
  } else if constexpr(std::is_same_v<T,std::array<float,3>>) {
   check(offset==addr::skater_state::body_velocity_offset,"physical velocity comes from native body record");
   return velocities[i];
  } else {
   check(offset==addr::skater_state::body_pending_flags_offset,"pending velocity is distinguished from consumed velocity");
   return pending[i];
  }
 }
 void verify(){++verified;source_require(!stale,"changed");}
};
@wallplant_wrapper_body_observation@
void run(){
