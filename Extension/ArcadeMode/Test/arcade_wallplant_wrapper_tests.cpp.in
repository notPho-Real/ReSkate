bool select(std::uintptr_t trajectory,bool launch){
 ++selections;
 check(trajectory==reinterpret_cast<std::uintptr_t>(object.data()) && launch,"native selector receives the original object and mode");
 object[native::query_pending]=after_selection;
 return false; // Selection's return value is not proof that pending work ended.
}
bool known_bytes(std::uintptr_t at,const unsigned char* bytes,std::size_t size){
 ++fingerprints;
 check(at==reinterpret_cast<std::uintptr_t>(&select) && bytes==native::select_result.bytes.data() &&
       size==native::select_result.bytes.size(),"selector fingerprint is checked before any native call");
