   case 0:native_context=99;break;case 1:writable=false;break;case 2:fixture_current=false;break;
   case 3:expire=true;break;case 4:physical_hold.command.input_sequence=8;break;
   case 5:fail_verify=true;break;case 6:change_snapshot=true;break;case 7:fail_read=1;break;
