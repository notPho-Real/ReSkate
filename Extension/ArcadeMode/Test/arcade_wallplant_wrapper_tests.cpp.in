 template<class T>T value(std::uintptr_t base,std::uintptr_t offset){
  if constexpr(std::is_same_v<T,std::uint32_t>){check(base==3,"ground reads held context state");return state_id;}
  else {check(base==2&&offset==spawn::rig_motion_origin,"ground reads native world origin");return world_origin;}
