  const bool granted=scenario>=2&&scenario<=5;
  check(routed==granted,"only an admitted native departure uses the existing setter route");
  check(sets==(granted?1u:0u)&&selections==0,"departure does not add a query or call the caller's selector");
  check(completions==(granted?1u:0u)&&submission==(scenario==2),"submission receipt requires observed world-space shaping");
  check(packet.values==original_packet.values,"native caller's packet and options remain unchanged");
  check(!world_trajectory_request.object,"native departure permission expires synchronously even on failure");
  if(scenario==1)check(offers==0&&object[native::query_pending]==1,"busy native query does not spend hold authority");
  if(scenario==2){
   check(candidate_velocity==exit&&object[native::query_pending]==1,"recorded slow departure is replaced before genuine query generation");
   check(submitted_reference==exit&&candidate_reference==exit,"native departure cannot retain the held speed in its reference record");
   const float speed=std::hypot(candidate_reference[0],candidate_reference[1],candidate_reference[2]);
   check(std::abs(speed-std::hypot(exit[0],exit[1],exit[2]))<1e-5f&&speed>13,
       "launch-enabled native candidate speed uses the full exit instead of sub-metre held motion");
   auto expected=original_packet;
   std::copy(exit.begin(),exit.end(),expected.values.begin()+32);
   std::copy(exit.begin(),exit.end(),expected.values.begin()+36);
   check(submitted_packet.values==expected.values,"native departure changes exactly the two three-component velocity records");
   object[native::query_pending]=0;
   check(!route_native_world_trajectory(at,packet.values.data(),native::pop_query_call.rva)&&sets==1&&completions==1,"same receipt cannot launch twice after query completion");
  }
 }
 hook.world_bridge.store(nullptr);skip_shape=fail_set=false;
