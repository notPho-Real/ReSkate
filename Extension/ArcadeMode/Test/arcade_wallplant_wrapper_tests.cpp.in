  if(fault==1){enabled=false;expected="wallplant_intent_disabled";}
  if(fault==2){intent_generation=8;expected="wallplant_intent_generation_changed";}
  if(fault==3){intent_future=true;expected="wallplant_intent_clock_reversed";}
  if(fault==4){sample_age=151;expected="wallplant_intent_expired";}
  if(fault==5){session=true;expected="wallplant_intent_multiplayer";}
  if(fault==6){sample_age=150;read_delay=1;expected="wallplant_intent_expired";}
  bool rejected=false;
