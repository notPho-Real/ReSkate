constexpr unsigned wanted_wipeout_reason=1;
std::uint64_t GetTickCount64(){return 100;}
bool protected_owner(std::uintptr_t,std::uintptr_t Owner::*){return false;}
void record_cause(std::uintptr_t,unsigned,float){}
void hold_off_board(std::uintptr_t,std::uint32_t){}
std::pair<std::uint64_t,bool> take_balance_bail(std::uintptr_t,std::uint32_t){return {};}
void dark_pop_before(std::uintptr_t,std::uint32_t){}
bool filter_requests(std::uintptr_t,std::uintptr_t Owner::*){return false;}
std::uint32_t original_choose(std::uintptr_t selector,std::uint32_t){
 ++chooser_calls;event("choose_original",selector);return native_result;
}
struct Protection {
 std::uint32_t (*choose_original)(std::uintptr_t,std::uint32_t)=original_choose;
 int lock{};struct Balance{void finish(std::uint64_t,bool,std::uint32_t){}} balance_bail;
} protection_value;
Protection& protection(){return protection_value;}
