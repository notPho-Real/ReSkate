@wallplant_wrapper_target@
std::uint64_t apply_arcade_wallplant_before_selection(std::uintptr_t selector,std::uint32_t current) noexcept {
 event("prepare",selector);
 if(!admit)return 0;
 auto& staged=wallplant_handoff();staged={};
 staged.execution.native.owner.core=1;
 staged.ticket={++serial,7,selector,current,0,false};
 return serial;
}
