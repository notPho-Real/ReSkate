void put(std::uintptr_t at,const std::array<float,3>& value){std::memcpy(reinterpret_cast<void*>(at+native::requested_velocity),value.data(),sizeof(value));}
bool select(std::uintptr_t at,bool mode){++selections;check(at==reinterpret_cast<std::uintptr_t>(object.data())&&mode,"original selector owns candidate acceptance");return false;}
