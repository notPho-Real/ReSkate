}
void run(){
 reset();noclip_ground_target(2,.03333333f);
 check(originals==1&&passed_seconds==.03333333f&&copies==1&&cancelled.empty(),"ground preserves native call/step and commits once");
 check(stored[28]==7&&stored[29]==8&&stored[30]==9,"ground uses bounded hold anchor");
 check(std::abs(stored[16+8]-1)<.00001f&&std::abs(stored[16+10])<.00001f,"ground target faces outgoing direction");
 check(!ground_state.busy.test_and_set(),"successful callback releases busy ownership");ground_state.busy.clear();
 reset();orientation_snapshot.limit=.785398163f;noclip_ground_target(2,.03333333f);
 check(copies==1&&cancelled.empty(),"native constrained orientation commits through the existing ground route");
 check(physical_hold.orientation.fraction>.49f&&physical_hold.orientation.fraction<.51f&&
       physical_hold.orientation.applied_error<=orientation_snapshot.limit,"ground turn uses actual native constraint");
 check(stored[28]==7&&stored[29]==8&&stored[30]==9,"orientation constraint preserves checked wall anchor");
 reset();orientation_available=false;noclip_ground_target(2,.03333333f);
 check(copies==0&&stored==prepared&&cancelled=="orientation_contract","missing native orientation contract refuses target mutation");
 reset();orientation_snapshot.limit=1.1f;orientation_snapshot.root_spin={0,3,0};
 orientation_snapshot.reference_spin={0,2,0};noclip_ground_target(2,.03333333f);
 check(copies==1&&cancelled.empty()&&physical_hold.orientation.applied_error<.934f,
       "production ground callback uses live angular motion in its target budget");
 reset();orientation_snapshot.root_spin={1000,0,0};noclip_ground_target(2,.03333333f);
 check(copies==0&&stored==prepared&&cancelled=="ground_target_motion_budget",
       "exhausted live angular budget cancels without changing body, target or native limit");
 for(unsigned changed=1;changed<=5;++changed){
  reset();change_orientation_at_permission=changed;noclip_ground_target(2,.03333333f);
  check(originals==1&&copies==0&&stored==prepared&&cancelled=="orientation_changed",
        "physical basis, local root, spin or limit changed during authority lookup rejects the stale target without a write");
 }
 reset();fixture_stale_query=true;noclip_ground_target(2,.03333333f);
 check(originals==1 && copies==0 && stored==prepared && cancelled.empty() && wallplant_hold_core.load()==1,
       "overtaken final target reader forwards native preparation without writing or canceling newer hold");
 check(physical_hold.started==100,"deferred target cannot restart planted duration");
 reset();clock_ms=285;noclip_ground_target(2,.03333333f);
 check(originals==1&&copies==1&&cancelled.empty()&&stored[29]==8,
       "due185ms release retains the anchored ground target before its body callback");
