std::vector<Event> events;
void event(const char* name,std::uintptr_t core=0,bool active=false){events.push_back({name,core,active});}
std::uint32_t native_result=100;
unsigned native_calls{},chooser_calls{},writes{},hold_releases{};
std::atomic<std::uintptr_t> wallplant_hold_core{};
bool release_hold{},begin_hold_on_write{};
bool reenter{},admit=true;
std::uint64_t serial{};
