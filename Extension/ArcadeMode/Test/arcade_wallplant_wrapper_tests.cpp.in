 reader.transforms[0][12]=10;reader.transforms[1][12]=20;
 const auto observed=wallplant_body_observation(bodies,reader);
 check(observed.root[0]==10 && observed.board[0]==20 && observed.root!=bodies.root,
       "entity target cannot masquerade as physical position");
 check(observed.forward==std::array<float,3>{0,0,1} && observed.velocity0==reader.velocities[0] &&
       observed.velocity8==reader.velocities[1],"physical facing and velocities retain distinct body observations");
 check(observed.pending0==0 && observed.pending8==8 && reader.verified==1,
       "pending status and one coherent snapshot accompany physical observation");
 for(unsigned bad=0;bad<3;++bad) {
  auto invalid=reader;
  if(bad==0)invalid.transforms[1][12]=std::numeric_limits<float>::quiet_NaN();
  if(bad==1)invalid.velocities[0][1]=std::numeric_limits<float>::quiet_NaN();
  if(bad==2)invalid.stale=true;
  bool refused=false;
  try{(void)wallplant_body_observation(bodies,invalid);}catch(const SourceGuard&){refused=true;}
  check(refused,"invalid or overtaken physical observation is refused");
 }
 std::cout<<checks<<" combined production physical observation checks passed\n";
}
}
