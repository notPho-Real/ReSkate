enum class Level {info};enum class Channel {skater};
unsigned correlation_rows{};
template<class... Args> void log(Level,Channel,const char*,Args&&...) {++correlation_rows;}
}
NativeRequestSample live_sample;
bool live_readable=true;
namespace memory {
bool peek(std::uintptr_t address,std::uint32_t& value) {
    if(!live_readable)return false;
    namespace native=game::build::v20260929::arcade_native_probe;
    if(address==4+native::selected_state)value=live_sample.state;
    else if(address==5+native::crouch_mode)value=live_sample.crouch_mode;
    else if(address==4+native::request_words)value=live_sample.words[0];
    else if(address==4+native::request_words+4)value=live_sample.words[1];
    else return false;
    return true;
}
}
bool enabled(){return mode;}
std::uint64_t GetTickCount64(){return clock_ms;}
void set_arcade_push_intent(bool value){push=value;}
void set_arcade_air_intent(bool value,unsigned,unsigned,unsigned,unsigned,bool){air=value;}
@controller_route_packet_retire@
@controller_route_binding_api@
@controller_route_binding_context@
void run(){
    unsigned checks{};
    for(unsigned slot=0;slot<4;++slot){
        mode=true;ready=true;controller_route.reset();arcade_input.enable(true);clock_ms=1000;
        require(set_controller_source(slot,1000),"actual command API arms selected source");++checks;
        NativeInputFrame frame{};frame.valid=true;frame.owner={1,2,3,4,5};frame.owner_generation=1;
        frame.contact_generation=frame.action_generation=1;frame.physics_step=1;frame.sampled_at=1000;frame.state=100;
        observe(controller_route,slot,{true,1000,0,0,0,0,0,0,0});controller_route.select(1000,15,true,frame);
        arcade_input.publish_native_context(frame);arcade_input.publish_authority(1000,1,1,true);
        require(controller_route.accepts(slot,1000)&&arcade_input.admitted(0,1000),"explicit multi-connected route retains independent facade authority proof");++checks;
        playback_packets={};playback_packets[slot].sample(20,20,true);playback_packets[slot].sample(20,20,true);
        push=air=true;gameplay_valid_until=1150;reset_physical_manual=false;
        const auto wallplant_cancellations=wallplant_runtime::cancellations;
        disconnect_xinput_source((slot+1)%4);
        require(arcade_input.admitted(0,1000)&&push&&air,"other source loss cannot withdraw selected actor");++checks;
        require(wallplant_runtime::cancellations==wallplant_cancellations,
            "other controller withdrawal cannot cancel selected wallplant ownership");++checks;
        disconnect_xinput_source(slot);
        require(!controller_route.accepts(slot,1000)&&!arcade_input.admitted(0,1000)&&!push&&!air&&!gameplay_valid_until&&reset_physical_manual,
            "actual disconnect callback revokes shared facade and native intentions immediately");++checks;
        require(wallplant_runtime::cancellations==wallplant_cancellations+1,
            "selected controller withdrawal cancels pending wallplant ownership once");++checks;
        require(playback_packets[slot].sample(22,22,false)==23,"actual revocation retires last synthetic packet without erasing collision debt");++checks;
        require(playback_packets[slot].sample(22,22,false)==22,"retirement is consumed exactly once");++checks;
        require(playback_packets[(slot+1)%4].sample(22,22,false)==22,"unowned controller retains native packet identity");++checks;
        observe(controller_route,slot,{true,1001,0,0,0,0,0,0,0});controller_route.select(1001,15,true,frame);
        require(!controller_route.accepts(slot,1001),"actual disconnect never elects a fallback or reconnect");++checks;
        require(set_controller_source(slot,1000),"explicit deliberate rearm remains possible");++checks;
        clear_controller_source();observe(controller_route,slot,{true,1001,0,0,0,0,0,0,0});controller_route.select(1001,1u<<slot,true,frame);
        require(!controller_route.accepts(slot,1001),"fixture teardown clear blocks even a remaining sole controller");++checks;
        mode=false;require(!set_controller_source(slot,1000),"OFF cannot arm explicit command authority");++checks;
        controller_route.reset();arcade_input.enable(false);arcade_input.enable(true);
        observe(controller_route,(slot+1)%4,{true,1002,0,0,0,0,0,0,0});controller_route.select(1002,1u<<((slot+1)%4),true);
        require(controller_route.accepts((slot+1)%4,1002),"OFF/ON plus fresh physical sample restores ordinary player handoff");++checks;
    }
    mode=true;mode_enabled=true;controller_route.reset();native_input_state={};motion_cleanup_state={};
    arcade_input.enable(false);arcade_input.enable(true);clock_ms=1000;
    NativeRequestSample sample{};sample.valid=true;sample.state=100;sample.crouch_mode=1;sample.words[1]=0xc000;
    const NativeInputOwner owner{1,2,3,4,5};
    const auto frame=native_input_state.observe(1000,owner,sample,{});
    const auto proof=motion_cleanup_state.observe(1000,owner,sample,{});
    set_controller_source(1,1000);observe(controller_route,1,{true,1000,0,0,0,0,0,0,0});
    controller_route.select(1000,3,true,proof);arcade_input.publish_native_context(frame);arcade_input.publish_authority(1000,frame.owner_generation,1,true);
    MotionCleanupProof cleanup{};
    const char* diagnostic{};
    require(native_air_context(1000,owner,sample,&cleanup,&diagnostic).valid&&cleanup.observed.valid,"actual physics consumer accepts selected route and independent native owner");++checks;
    require(std::string_view(diagnostic)=="frame_valid","writer diagnostic copies successful correlation without another call");++checks;
    auto changed=sample;changed.state=201;
    require(!native_air_context(1000,owner,changed,&cleanup,&diagnostic).valid&&
        std::string_view(diagnostic)=="frame_correlation","writer diagnostic distinguishes changed native state from route rejection");++checks;
    bool contention_reported{};
    {
        std::lock_guard held(ollie_mutex);
        std::thread consumer([&] {
            MotionCleanupProof local_cleanup{};const char* reason{};
            const auto unavailable=native_air_context(1000,owner,sample,&local_cleanup,&reason);
            contention_reported=!unavailable.valid&&!local_cleanup.inspected&&std::string_view(reason)=="frame_lock_busy";
        });
        consumer.join();
    }
    require(contention_reported,"writer contention copies its reason without waiting, retrying or granting cleanup authority");++checks;
    require(logging::correlation_rows==0,"ordinary correlation and contention never emit wallplant diagnostics");++checks;
    // Extracted production accessor: a pending preselector waits for the
    // publisher, then samples time/state and all existing admission gates.
    // No sleep or retry budget; the publisher owns the mutex throughout edits.
    {
        unsigned synchronizations{},revalidations{};
        NativeInputFrame ordinary{};ordinary.valid=true;ordinary.sampled_at=17;
        const auto sync=[&]{++synchronizations;return NativeInputFrame{};};
        const auto validate=[&](const NativeInputFrame&){++revalidations;return true;};
        const auto unchanged=wallplant_surface_frame(ordinary,true,sync,validate);
        require(unchanged.frame.valid&&unchanged.frame.sampled_at==17&&!unchanged.wallplant_only&&
            !synchronizations&&!revalidations,"ordinary successful query is never replaced or synchronized");++checks;
        require(!wallplant_surface_frame({},false,sync,validate).frame.valid&&!synchronizations,
            "absent retained contact never turns ordinary contention into blocking admission");++checks;
    }
    for(unsigned boundary=0;boundary<7;++boundary) {
        clock_ms=1000;mode_enabled=true;live_readable=true;live_sample=sample;
        controller_route.reset();arcade_input.enable(false);arcade_input.enable(true);
        set_controller_source(1,1000);observe(controller_route,1,{true,1000,0,0,0,0,0,0,0});
        controller_route.select(1000,3,true,frame);arcade_input.publish_native_context(frame);
        arcade_input.publish_authority(1000,frame.owner_generation,1,true);
        NativeInputFrame acquired{};std::uint64_t acquired_at{};const char* reason{};
        std::atomic<bool> entered{};
        std::unique_lock publisher(ollie_mutex);
        std::thread selector([&] {
            entered.store(true,std::memory_order_release);
            acquired=native_wallplant_context(owner,acquired_at,&reason).native;
        });
        while(!entered.load(std::memory_order_acquire))std::this_thread::yield();
        clock_ms=boundary==1?1151:1001;
        if(boundary==1)observe(controller_route,1,{true,clock_ms,0,0,0,0,0,0,0});
        if(boundary==2)mode_enabled=false;
        if(boundary==3)controller_route.clear();
        if(boundary==4)live_sample.state=201;
        if(boundary==5)live_readable=false;
        if(boundary==6)arcade_input.invalidate_authority();
        publisher.unlock();selector.join();
        require(acquired_at==clock_ms,"preselector refreshes time after serialized acquisition");++checks;
        require(acquired.valid==(boundary==0),"contention must not bypass stale/state/read/route/OFF/authority rejection");++checks;
        if(boundary==0) {
            require(acquired.sampled_at==1000&&acquired.physics_step==frame.physics_step&&
                std::string_view(reason)=="frame_valid","serialized handoff returns the unchanged original native frame");++checks;
        }
    }
    clock_ms=1000;mode_enabled=true;live_readable=true;live_sample=sample;
    require(logging::correlation_rows==2,"only pending correlation failures emit same-read diagnostics; earlier authority rejection stays unchanged");++checks;
    controller_route.clear();
    require(!native_air_context(1000,owner,sample,&cleanup,&diagnostic).valid&&cleanup.observed.valid,"route withdrawal suppresses motion command without destroying cleanup proof");++checks;
    require(std::string_view(diagnostic)=="frame_route","writer diagnostic copies physical route rejection");++checks;
    mode_enabled=false;
    require(!native_air_context(1000,owner,sample,&cleanup,&diagnostic).valid&&cleanup.observed.valid,"OFF cannot revive command authority through independent cleanup proof");++checks;
    require(std::string_view(diagnostic)=="frame_disabled","writer diagnostic preserves OFF-before-route ordering");++checks;
    for(unsigned boundary=0;boundary<7;++boundary) {
        clock_ms=1000;mode_enabled=true;live_readable=true;native_input_state={};
        arcade_input.enable(false);arcade_input.enable(true);controller_route.reset();
        NativeRequestSample original{};original.valid=true;original.state=201;original.crouch_mode=2;
        const auto air_frame=native_input_state.observe(1000,owner,original,{});
        set_controller_source(1,1000);observe(controller_route,1,{true,1000,0,0,0,0,0,0,0});
        controller_route.select(1000,3,true,air_frame);arcade_input.publish_native_context(air_frame);
        arcade_input.publish_authority(1000,air_frame.owner_generation,1,true);
        live_sample=original;live_sample.crouch_mode=1;live_sample.words[1]=0x8000;
        clock_ms=1035;
        if(boundary==1)mode_enabled=false;
        if(boundary==2)controller_route.clear();
        if(boundary==3)arcade_input.invalidate_authority();
        if(boundary==4)clock_ms=1151;
        if(boundary==5)live_sample.words[0]=0x20;
        if(boundary==6)live_sample.state=100;
        std::uint64_t acquired_at{};
        const auto execution_proof=native_wallplant_context(owner,acquired_at,&diagnostic);
        require(execution_proof.native.valid==(boundary==0),"production wallplant contact phase still requires controller, fresh frame, authority and exact native transition");++checks;
        if(boundary==0) {
            require(execution_proof.imported_contact&&execution_proof.native.mode==2&&execution_proof.native.contacts==0&&
                execution_proof.native.sampled_at==1000&&execution_proof.native.physics_step==air_frame.physics_step&&
                execution_proof.live.crouch_mode==1&&execution_proof.live.words[1]==0x8000,
                "production handoff separates unchanged original frame from live imported contact");++checks;
            require(!native_air_context(acquired_at,owner,live_sample,nullptr,&diagnostic).valid,
                "wallplant phase does not relax the ordinary motion accessor");++checks;
        }
    }
    for(unsigned boundary=0;boundary<11;++boundary) {
        clock_ms=1035;mode_enabled=true;action_mode=ActionExperiment::classic;
        arcade_input.enable(false);arcade_input.enable(true);controller_route.reset();native_input_state={};
        NativeRequestSample original{};original.valid=true;original.state=201;original.crouch_mode=2;
        const auto original_frame=native_input_state.observe(1000,owner,original,{});
        set_controller_source(1,1000);
        ArcadeInput::Physical physical{true,1035,0,0,0,0,0,0,0};
        observe(controller_route,1,physical);controller_route.select(1035,3,true,original_frame);
        arcade_input.publish_native_context(original_frame);arcade_input.publish_authority(1035,original_frame.owner_generation,1,true);
        if(boundary==1)mode_enabled=false;
        if(boundary==2)action_mode=ActionExperiment::off;
        if(boundary==3)physical.buttons=0x4000;
        if(boundary==4)physical.lt=31;
        if(boundary==5)physical.rt=31;
        if(boundary==6)controller_route.clear();
        if(boundary==7)arcade_input.invalidate_authority();
        if(boundary==8)clock_ms=1151;
        if(boundary==9) {
            const auto next=native_input_state.observe(1035,owner,original,{});
            arcade_input.publish_native_context(next);
        }
        if(boundary==10) {
            auto next=original_frame;++next.owner_generation;
            arcade_input.publish_native_context(next);arcade_input.publish_authority(1035,next.owner_generation,1,true);
        }
        if(boundary>=3&&boundary<=5)observe(controller_route,1,physical);
        std::uint64_t checked_at{};
        require(native_wallplant_execution_authorized(original_frame,checked_at)==(boundary==0),
            "post-native handoff retains controller/OFF/classic/conflict/trigger/freshness/exact-episode authority");++checks;
        require(checked_at==clock_ms,"post-native handoff samples current time after input serialization");++checks;
    }
    // Start a real session-owned crouch through the production recognizer,
    // then publish a native AIR observation without releasing its held input.
    // A matching AIR frame/route must not turn this competing owner into a kick.
    {
        clock_ms=1000;mode_enabled=true;action_mode=ActionExperiment::classic;
        arcade_input.enable(false);arcade_input.enable(true);controller_route.reset();native_input_state={};
        NativeRequestSample ground{};ground.valid=true;ground.state=100;ground.crouch_mode=1;ground.words[1]=0xc000;
        const auto grounded=native_input_state.observe(1000,owner,ground,{true,-1,0x300000});
        set_controller_source(1,1000);observe(controller_route,1,{true,1000,0,0,0,0,0,0,0});
        controller_route.select(1000,3,true,grounded);arcade_input.publish_native_context(grounded);
        arcade_input.publish_authority(1000,grounded.owner_generation,1,true);
        const std::array prepared{PreparedGesture{1,false,GestureContext::ground,
            std::vector<AuthoredStickStep>{{0,0,-32767},{18,25000,28000},{21,0,0},{24,0,0}}}};
        const auto poll=[&](std::uint64_t at,std::uint16_t buttons) {
            return arcade_input.poll(0,at,buttons,0,0,0,0,true,true,false,0,false,false,true,
                at/17,false,prepared,false,true,SkatePose::riding);
        };
        poll(1000,0);
        const auto held=poll(1017,0x1000);
        require(held.authored_playback&&arcade_input.busy(0)&&!arcade_input.wallplant_controls_unowned(0),
            "actual admitted held crouch owns the session before late wallplant execution");++checks;
        auto air_sample=ground;air_sample.state=201;air_sample.crouch_mode=2;air_sample.words[1]=0;
        const auto airborne=native_input_state.observe(1035,owner,air_sample,{true,1,0x300000});
        clock_ms=1035;observe(controller_route,1,{true,1035,0x1000,0,0,0,0,0,0});
        controller_route.select(1035,3,true,airborne);arcade_input.publish_native_context(airborne);
        arcade_input.publish_authority(1035,airborne.owner_generation,1,true);
        std::uint64_t checked_at{};
        require(arcade_input.admitted(0,1035)&&controller_route.physical(1035).valid&&
            wallplant_same_observation(airborne,arcade_input.native_context(1035)),
            "competing-session test retains otherwise valid exact frame and controller authority");++checks;
        require(!native_wallplant_execution_authorized(airborne,checked_at),
            "production late execution rejects a real busy held session even with matching AIR proof");++checks;
    }
    // A real native100 during an owned physical hold cannot start ordinary
    // crouch/Ollie. Poll raw A throughout the hold so release does not recreate
    // a press from an already-held physical button.
    {
        ArcadeInput held_input(true);held_input.enable(true);NativeInputState tracker;
        NativeRequestSample native{};native.valid=true;native.state=100;native.crouch_mode=1;native.words[1]=0xc000;
        const std::array prepared{PreparedGesture{1,false,GestureContext::ground,
            std::vector<AuthoredStickStep>{{0,0,-32767},{18,25000,28000},{21,0,0},{24,0,0}}}};
        const auto hold_sample=[&](std::uint64_t at,std::uint16_t buttons,bool holding) {
            const auto frame=tracker.observe(at,owner,native,{true,-1,0x300000},false,1.f/30);
            held_input.publish_native_context(frame);held_input.publish_authority(at,frame.owner_generation,1,true);
            return held_input.poll(0,at,buttons,0,0,0,0,true,!holding,false,0,false,false,true,
                at/17,false,prepared,false,true,SkatePose::riding);
        };
        hold_sample(1000,0,true);
        for(const auto at:{1017u,1034u,1051u}) {
            const auto held=hold_sample(at,0x1000,true);
            require(!held.authored_playback&&!held_input.busy(0)&&held.requested_id==0,
                "native100 hold repeated A never acquires ordinary jump");++checks;
        }
        hold_sample(1068,0,true);
        const auto pressed=hold_sample(1085,0x1000,true);
        require(!pressed.authored_playback&&pressed.requested_id==0,
            "second physical press remains journaled without ground launch during hold");++checks;
        for(const auto at:{1160u,1177u}) {
            const auto held=hold_sample(at,0x1000,false);
            require(!held.authored_playback&&!held_input.busy(0)&&held.requested_id==0,
                "held A spanning physical release does not become a synthetic fresh press");++checks;
        }
        const auto released=hold_sample(1194,0,false);
        require(!released.authored_playback&&released.requested_id==0,
            "unowned hold-era A release cannot produce fallback Ollie");++checks;
        const auto fresh=hold_sample(1211,0x1000,false);
        require(fresh.authored_playback&&held_input.busy(0),
            "independent later physical A retains ordinary ground control");++checks;
    }
    // Use the actual geometry accessors with a contended producer mutex.
    // Ordinary callers still yield; retained wall queries wait for the owner
    // then inspect the original frame at the real acquisition time.
    for(unsigned boundary=0;boundary<8;++boundary) {
        clock_ms=1000;mode_enabled=true;native_input_state={};
        arcade_input.enable(false);arcade_input.enable(true);
        NativeRequestSample air_sample{};air_sample.valid=true;air_sample.state=201;air_sample.crouch_mode=2;
        const auto original=native_input_state.observe(1000,owner,air_sample,{});
        arcade_input.publish_native_context(original);arcade_input.publish_authority(1000,original.owner_generation,1,true);
        NativeInputFrame ordinary{},acquired{};const char* ordinary_reason{};const char* acquired_reason{};
        WallplantSurfaceFrame rescued{};bool retained_current=true;
        std::atomic<bool> waiting{};
        std::unique_lock publisher(ollie_mutex);
        std::thread query([&] {
            ordinary=surface_geometry_native_frame(clock_ms,&ordinary_reason);
            waiting.store(true,std::memory_order_release);
            rescued=wallplant_surface_frame(ordinary,true,[&] {
                acquired=wallplant_surface_geometry_native_frame(&acquired_reason);return acquired;
            },[&](const NativeInputFrame& candidate_frame) {
                return retained_current && candidate_frame.owner==original.owner && candidate_frame.owner_generation==original.owner_generation &&
                    candidate_frame.airborne && candidate_frame.airborne_episode==original.airborne_episode && candidate_frame.air_departure==original.air_departure;
            });
        });
        while(!waiting.load(std::memory_order_acquire))std::this_thread::yield();
        clock_ms=boundary==1?1151:boundary==6?999:1001;
        if(boundary==2)mode_enabled=false;
        if(boundary==3)arcade_input.invalidate_authority();
        if(boundary==4)arcade_input.publish_native_context({});
        if(boundary==5) {
            auto landed=air_sample;landed.state=100;landed.crouch_mode=1;landed.words[1]=0x8000;
            arcade_input.publish_native_context(native_input_state.observe(1001,owner,landed,{}));
        }
        if(boundary==7)retained_current=false;
        publisher.unlock();query.join();
        require(!ordinary.valid&&std::string_view(ordinary_reason)=="frame_lock_busy",
            "ordinary geometry retains its nonblocking contention behavior");++checks;
        require(acquired.valid==(boundary==0||boundary==5||boundary==7),
            "synchronized wall query still rejects expired/future/OFF/authority/invalid native context");++checks;
        require(rescued.frame.valid==(boundary==0)&&rescued.wallplant_only==(boundary==0),
            "retained-only admission rejects changed contact/ground and cannot publish rescued ordinary geometry");++checks;
        if(boundary==0) {
            require(acquired.sampled_at==original.sampled_at&&acquired.physics_step==original.physics_step&&
                std::string_view(acquired_reason)=="frame_valid",
                "contention resolution preserves original native timestamp and step");++checks;
        }
        if(boundary==5) {
            require(acquired.state==100&&!acquired.airborne&&acquired.physics_step>original.physics_step&&
                acquired.action_generation!=original.action_generation,
                "native transition while waiting is returned honestly for existing callback provenance rejection");++checks;
        }
    }
    struct SelectionProbe {std::uint64_t input{},contact{},raw{};NativeInputFrame native{};};
    {
        unsigned synchronized{},read_pending{};WallplantExecutionProof execution{};
        const auto absent=wallplant_pending_after_arbitration(SelectionProbe{},execution,[&] {
            ++synchronized;return WallplantExecutionProof{};
        },[&] {++read_pending;return SelectionProbe{};});
        require(!absent.input&&!synchronized&&!read_pending,
            "no retained collision keeps selection arbitration entirely inactive");++checks;
    }
    for(unsigned boundary=0;boundary<10;++boundary) {
        clock_ms=1000;mode_enabled=true;live_readable=true;native_input_state={};
        NativeRequestSample air_sample{};air_sample.valid=true;air_sample.state=201;air_sample.crouch_mode=2;
        live_sample=air_sample;
        const auto original=native_input_state.observe(1000,owner,air_sample,{});
        controller_route.reset();arcade_input.enable(false);arcade_input.enable(true);
        set_controller_source(1,1000);observe(controller_route,1,{true,1000,0,0,0,0,0,0,0});
        controller_route.select(1000,3,true,original);arcade_input.publish_native_context(original);
        arcade_input.publish_authority(1000,original.owner_generation,1,true);
        const SelectionProbe retained{0,3,14935,original};
        SelectionProbe pending{},admitted{};WallplantExecutionProof execution{};
        std::uint64_t acquired_at{};const char* reason{};std::atomic<bool> entered{};
        std::unique_lock publisher(ollie_mutex);
        std::thread selector([&] {
            admitted=wallplant_pending_after_arbitration(retained,execution,[&] {
                entered.store(true,std::memory_order_release);
                return native_wallplant_context(owner,acquired_at,&reason);
            },[&] {return pending;});
        });
        while(!entered.load(std::memory_order_acquire))std::this_thread::yield();
        require(!pending.input,"pending is genuinely absent before serialized dispatch completes");++checks;
        clock_ms=boundary==8?1151:1001;
        pending={29,retained.contact,retained.raw,original};
        if(boundary==1)pending={}; // No A was admitted by the existing dispatcher.
        if(boundary==2)++pending.native.owner.core;
        if(boundary==3)++pending.raw;
        if(boundary==4)++pending.contact;
        if(boundary==5)++pending.native.physics_step;
        if(boundary==6)live_sample.state=100;
        if(boundary==7)mode_enabled=false;
        if(boundary==8)observe(controller_route,1,{true,clock_ms,0,0,0,0,0,0,0});
        if(boundary==9)arcade_input.invalidate_authority();
        publisher.unlock();selector.join();
        require(admitted.input==(boundary==0?29u:0u),
            "arbitration sees published A only with exact retained owner/contact/frame and live admission");++checks;
        require(acquired_at==clock_ms,"selection arbitration validates time after acquiring input ownership");++checks;
        if(boundary==0) {
            require(wallplant_same_observation(execution.native,original)&&admitted.native.sampled_at==1000,
                "waiting for dispatch neither renews the original AIR frame nor manufactures a newer episode");++checks;
        }
    }
    std::cout<<checks<<" exact production binding API checks passed\n";
}
}

namespace binding_phase {
NativeControllerRoute controller_route;
NativeInputState motion_cleanup_state;
using NoBailSkater=NativeInputOwner;
NativeInputOwner live_owner;
NativeRequestSample live_sample;
struct {bool available{true};} input;
NativeInputOwner input_owner(const NoBailSkater& owner){return owner;}
NativeRequestSample native_request_sample(NoBailSkater& owner){owner=live_owner;return live_sample;}
NativeInputFrame production_proof(std::uint64_t route_now,bool route_enabled=true){
    NativeInputFrame binding_proof{};
@controller_route_binding_owner@
    return binding_proof;
}
void setup(unsigned slot){
    controller_route.reset();motion_cleanup_state={};input.available=true;
    live_owner={1,2,3,4,5};live_sample={};live_sample.valid=true;
    live_sample.state=100;live_sample.crouch_mode=1;live_sample.words[1]=0xc000;
    motion_cleanup_state.observe(1000,live_owner,live_sample,{true,-1,0x300000},false,1.0f/30);
    require(controller_route.arm(slot,1000,60000),"phase fixture arms existing finite binding");
    observe(controller_route,slot,{true,1000,0,0,0,0,0,0,0});
    controller_route.select(1000,15,true,production_proof(1000));
    require(controller_route.accepts(slot,1000),"original physics owner admits neutral selected slot");
}
void run(){
    unsigned checks{};
    struct Phase {unsigned state,mode,contacts;int flip;unsigned stance{};};
    // Actual ordinary jump progression plus native one-wheel transitions. A
    // client sample can precede the next original physics observation of each.
    constexpr std::array phases{Phase{100,0,0xc000,1},Phase{103,0,0xc000,1},
        Phase{200,0,0,1},Phase{201,2,0,1},Phase{201,2,0,-1},
        Phase{100,1,0xc000,-1},Phase{100,1,0x4000,-1,0x40},
        Phase{100,1,0x8000,-1,0x60},Phase{100,1,0xc000,-1,0x20},
        Phase{100,1,0xc000,-1}};
    for(unsigned slot=0;slot<4;++slot){
        setup(slot);std::uint64_t physics_at=1000;
        const auto original=production_proof(1000);
        for(const auto phase:phases){
            const auto previous=production_proof(physics_at);
            live_sample.state=phase.state;live_sample.crouch_mode=phase.mode;
            live_sample.words[1]=phase.contacts;live_sample.words[0]=phase.stance;
            const auto client_at=physics_at+8;
            const bool ahead=previous.state!=phase.state||previous.mode!=phase.mode||previous.contacts!=phase.contacts||
                previous.stance_and_push!=phase.stance;
            if(ahead){
                require(!motion_cleanup_state.correlate(client_at,live_owner,live_sample).valid,
                    "newer client phase never acquires gameplay authority from the older original frame");++checks;
            }
            const auto proof=production_proof(client_at);
            observe(controller_route,slot,{true,client_at,0,0,0,0,0,0,0});
            controller_route.select(client_at,15,true,proof);
            require(controller_route.accepts(slot,client_at)&&controller_route.binding_state()==2,
                "same-owner client/physics phase gap cannot permanently revoke the bound transport");++checks;
            require(proof.valid&&proof.owner_generation==original.owner_generation&&
                proof.sampled_at==physics_at&&proof.physics_step==previous.physics_step&&
                proof.state==previous.state&&proof.mode==previous.mode&&proof.contacts==previous.contacts&&
                proof.stance_and_push==previous.stance_and_push,
                "actual binding publication retains unchanged original owner proof without projecting newer phase or time");++checks;
            physics_at=client_at+25;
            const auto observed=motion_cleanup_state.observe(physics_at,live_owner,live_sample,
                {true,phase.flip,0x300000},false,1.0f/30);
            require(observed.valid&&observed.owner_generation==original.owner_generation&&
                motion_cleanup_state.correlate(physics_at,live_owner,live_sample).valid,
                "only the next actual physics observation restores matching gameplay correlation");++checks;
            observe(controller_route,slot,{true,physics_at,0,0,0,0,0,0,0});
            controller_route.select(physics_at,15,true,production_proof(physics_at));
            require(controller_route.accepts(slot,physics_at),"original observed phase refresh preserves transport owner episode");++checks;
        }
        for(unsigned fault=0;fault<10;++fault){
            setup(slot);std::uint64_t at=1017;
            if(fault==0)live_sample.valid=false;
            if(fault==1)live_sample.state=0;
            if(fault==2)++live_owner.rig;
            if(fault==3)motion_cleanup_state.invalidate();
            if(fault==4)at=1151;
            if(fault==5)at=999;
            if(fault==6){motion_cleanup_state.invalidate();motion_cleanup_state.observe(at,live_owner,live_sample,{true,-1,0x300000});}
            if(fault==7)motion_cleanup_state.observe(at,live_owner,live_sample,{true,-1,0x300000},true);
            if(fault==8)input.available=false;
            const auto proof=production_proof(at,fault!=9);
            if(fault!=6&&fault!=7)require(!proof.valid,"invalid native/current owner/age/clock/focus/OFF never borrows a cached owner frame");
            observe(controller_route,slot,{true,at,0,0,0,0,0,0,0});
            controller_route.select(at,15,true,proof);
            require(!controller_route.accepts(slot,at),"actual owner-generation replacement and every original authority exclusion still revoke binding");++checks;
        }
    }
    std::cout<<checks<<" exact production binding phase checks passed\n";
}
}

namespace preparation_path {
std::array<AirRotation,4> prewinds;
AirRotation::Output sample(unsigned now,unsigned buttons,const NativeInputFrame& rotation_native,bool authored,bool manual=false){
 const std::uint16_t physical_buttons=static_cast<std::uint16_t>(buttons);
 const bool rotation_enabled=true,crouched=false,reference=false;
 NativeGesture::Output result{};result.authored_playback=authored;
 ActionInputOutput action{};struct{bool valid;}hop_origin{manual};
 AirRotation::Output rotation{};
@controller_route_preparation@
 return rotation;
}
void run(){
 for(unsigned dt:{8u,17u,34u})for(auto side:{BoardChord::lb,BoardChord::rb}){
  prewinds={};NativeInputState producer;NativeInputOwner owner{1,2,3,4,5};
  auto poll=[&](unsigned now,unsigned buttons,unsigned state,bool authored){
   NativeRequestSample raw{};raw.valid=true;raw.state=state;raw.crouch_mode=state==103?0:1;raw.words[1]=state==200?0:0xc000;
   return sample(now,buttons,producer.observe(now,owner,raw,{true,1,16}),authored);
  };
  poll(1000,0,100,false);poll(1000+dt,side,100,false);
  const auto ground=poll(1000+2*dt,side|0x1000u,103,true);
  require(!ground.x&&!ground.y,"actual preparation publication cannot steer native grounded crouch");
  auto air=poll(1000+3*dt,side,200,true);
  for(unsigned now=1000+4*dt;now<1300;now+=dt)air=poll(now,side,200,true);
  require(air.owns_left&&air.x==(side==BoardChord::lb?-31783:31783),"actual remap call retains short authored native crouch even with neutral RS and delayed client pose");
  require(!poll(1300,0,200,false).owns_left,"actual preparation publication releases shoulder command");
 }
}
}

void run_controller_publication_tests(){
    preparation_path::run();
    unsigned checks{};
    for(unsigned user=0;user<4;++user)for(bool nollie:{false,true}){
        const std::uint64_t base=user*10000u+(nollie?5000u:0u);
        route.reset();arcade_input.enable(false);arcade_input.enable(true);
        native_charges={};
        establish(user,(base+1000));
        NativeGesture::Output setup{};setup.jump.setup_started=true;setup.jump.pressed_at=(base+1000);
        setup.jump.launch=LaunchDescriptor::ordinary();
        setup.jump.nollie=nollie;
        sink={};writers(user,(base+1000),setup,SkatePose::riding);
        require(sink.push==1&&sink.drive&&sink.air==1,"each sole physical slot publishes admitted native push and air intentions");++checks;
        // Refresh both original physical/source and native admission proofs.
        establish(user,(base+1120));
        NativeGesture::Output release{};release.jump.released=release.jump.setup_admitted=true;
        release.jump.pressed_at=(base+1000);release.jump.released_at=(base+1120);release.jump.launch=LaunchDescriptor::ordinary();
        release.jump.nollie=nollie;
        release.ground_turn.serial=1;
        sink={};writers(user,(base+1120),release,SkatePose::riding);
        require(sink.air==1&&sink.release&&sink.charge==120&&sink.angular&&sink.yaw==2&&sink.ground_turn,
            "every physical slot publishes real charged-release identity, angular rate and ground-turn command");++checks;
        require(sink.native_launch_id==(nollie?16:1),"production publication carries only the admitted setup's native launch identity");++checks;
        // No per-physical charge actor is introduced: source1-3 use actor0 too.
        for(unsigned other=1;other<4;++other){
            const auto unbound=native_charges[other].semantic_release((base+1121),false,false,false,0,0,true);
            require(!unbound.sequence,"nonlocal charge actors never acquire setup ownership");++checks;
        }
        sink={};writers(user,(base+1121),{},SkatePose::air);
        require(sink.air==1&&sink.angular&&sink.yaw==2&&!sink.ground_turn,"air rotation publication is available to every selected physical source");++checks;
        for(auto side:{BoardChord::lb,BoardChord::rb})for(unsigned fault=0;fault<4;++fault){
            NativeGesture::Output grab{};grab.action.owned=true;
            grab.action.native_grab_triggers=fault!=1;
            grab.action.pad.owns_triggers=true;grab.action.pad.right_trigger=255;
            grab.action.pad.owns_left_stick=fault==2;
            sink={};writers(user,(base+1121),grab,SkatePose::air,fault==3,false,false,side);
            require(sink.air==1&&sink.angular==(fault==0)&&sink.yaw==0&&!sink.release&&!sink.ground_turn,
                "exact production statements share native trigger-only grab with held shoulder, but never add body rate/pop or bypass another owner");++checks;
        }
        for(unsigned blocked=0;blocked<3;++blocked){
            sink={};writers(user,(base+1121),release,SkatePose::riding,blocked==0,blocked==1,blocked==2);
            require(!sink.ground_turn,"reference playback, competing actor and Manual release retain ground-turn exclusions");++checks;
        }
        for(unsigned other=0;other<4;++other)if(other!=user){
            sink={};writers(other,(base+1121),release,SkatePose::riding);
            require(!sink.air&&!sink.push,"nonowner cannot publish native intentions");++checks;
        }
        sink={};writers(user,(base+1271),release,SkatePose::riding);
        require(!sink.air&&!sink.push,"expired source/client proof cannot publish native intentions");++checks;
        establish(user,(base+1300),3);sink={};writers(user,(base+1300),release,SkatePose::riding);
        require(!sink.air&&!sink.push,"ambiguous connected sources cannot publish native intentions");++checks;
        route.reset();arcade_input.enable(false);sink={};writers(user,(base+1301),release,SkatePose::riding);
        require(!sink.air&&!sink.push,"OFF cannot publish native intentions");++checks;
        arcade_input.enable(true);establish(user,(base+2000));
        const std::array prepared{PreparedGesture{1,false,GestureContext::ground,
            std::vector<AuthoredStickStep>{{0,0,-32767},{18,25000,28000},{21,0,0},{24,0,0}}}};
        auto input_poll=[&](std::uint64_t at,std::uint16_t buttons){
            return arcade_input.poll(NativeControllerRoute::session,at,buttons,0,0,0,0,true,true,false,0,
                false,false,true,at/17,false,prepared,false,true,SkatePose::riding);
        };
        input_poll((base+2000),0);establish(user,(base+2017));const auto crouch=input_poll((base+2017),0x1000);
        require(crouch.authored_playback,"actual logical session admits ordinary crouch setup");++checks;
        establish(user,(base+2200));input_poll((base+2200),0x1000);establish(user,(base+2267));const auto jump=input_poll((base+2267),0);
        require(jump.authored_playback&&arcade_input.allows_air_rotation(0,true),"actual logical session owns the ordinary jump metadata");++checks;
        sink={};writers(user,(base+2267),jump,SkatePose::air);
        require(sink.air==1&&sink.angular&&sink.yaw==2,"physical source uses logical actor's ordinary jump rotation permission");++checks;
    }
    packet_restoration::run();
    binding_api::run();
    binding_phase::run();
    std::cout<<checks<<" exact production native publication checks passed\n";
}
