namespace dingosdk::arcade_mode {
std::mutex ollie_mutex;
ArcadeInput arcade_input{true};
NativeControllerRoute controller_route;
NativeInputReadiness native_readiness;
NativeInputFrame capture_native_frame;
std::array<std::uint32_t,8> capture_native_words{};
float capture_physics_dt=.016f,capture_cached_dt=.016f;
std::uint64_t capture_cached_at=1000;
bool capture_focus=true,capture_gameplay=true,capture_source_available=true,capture_cached_valid=true,capture_bitmap_readable=true;
unsigned capture_bitmap_as_read=2;std::uint64_t capture_source_at=1000;
std::atomic<bool> input_clock_valid{true},controller_capture_live{};
CaptureCorrelationProducer input_capture_correlation;
struct CaptureManualJoinFixture {
    std::uint64_t request{},recognized_ms{},owner_generation{},episode{},session{};
    std::int8_t family{};bool from_air{},last_owns{},last_reserved{},last_neutral{},exit_seen{};
    unsigned exit_reason{};NativeInputOwner owner{};
    std::uint8_t last_writer{255};std::int16_t last_rx{},last_ry{};
}capture_manual_join;
std::atomic<bool> capture_transport_pending{};
std::uint64_t capture_model_sequence{},capture_termination_sequence{};
void capture_event(CaptureCorrelationSource,std::uint64_t,std::uint64_t,const NativeInputFrame&){}
InputTelemetry telemetry;
InputTelemetryLink input_telemetry;
std::array<PlaybackPacket,4> playback_packets;
bool mode=true;
bool enabled(){return mode;}
bool capture_row(const CaptureCorrelationEvidence& row){
    if(row.kind==CaptureCorrelationKind::begin&&row.schema==3)check(controller_capture_live.load(),"activation gate precedes the emitted begin boundary");
    if(row.kind==CaptureCorrelationKind::end&&row.schema==3)controller_capture_live=false;
    return input_telemetry.client(row);
}
@controller_capture_context@
@controller_capture_polls@
bool activate(unsigned required_sources,unsigned duration_ms){
    std::lock_guard lock(ollie_mutex);const auto now=GetTickCount64();const auto frame=capture_native_frame;
    const bool semantic=false;
@controller_capture_activation@
    return begun;
}
void off_capture(){const bool value=false;
@controller_capture_off@
    mode=false;controller_route.reset();arcade_input.enable(false);native_readiness.reset();
    for(auto& p:playback_packets)p.retire();
}
void observe_xinput_source(unsigned,unsigned short,unsigned char,unsigned char,short,short,short,short){}
void disconnect_xinput_source(unsigned slot){controller_route.disconnected(slot);}
// Controlled nonactuating gameplay boundary. The actual diagnostic scope and
// packet cancellation branch below are extracted unchanged from remap_xinput.
unsigned remap_xinput(unsigned user,unsigned short& buttons,short& right_x,short& right_y,bool game_input,
                     short& left_x,short& left_y,unsigned char&,unsigned char&,std::uint32_t physical_packet,ControllerPollCapture* capture){
    std::lock_guard lock(ollie_mutex);auto now=GetTickCount64();NativeGesture::Output result{};
    result.buttons=buttons;result.right_x=right_x;result.right_y=right_y;
@controller_capture_remap_trace@
@controller_route_packet_reject@
    capture_game_input=mode&&game_input;
    if(capture_game_input){buttons^=0x2000;right_x=1234;left_y=2345;result.buttons=buttons;result.right_x=right_x;result.phase=3;capture_ownership=16;}
    (void)left_x;
    return physical_packet^playback_packets[user].sample(physical_packet,physical_packet,capture_game_input);
}
}
namespace hook {
using DWORD=std::uint32_t;
#define WINAPI
constexpr DWORD ERROR_SUCCESS=0,ERROR_DEVICE_NOT_CONNECTED=1167;
struct Gamepad {unsigned short wButtons{};unsigned char bLeftTrigger{},bRightTrigger{};short sThumbLX{},sThumbLY{},sThumbRX{},sThumbRY{};};
struct XINPUT_STATE {DWORD dwPacketNumber{};Gamepad Gamepad{};};
unsigned overlay_input_access{};
bool blocked{},filter_enabled{};unsigned reads{};DWORD read_result{};XINPUT_STATE raw{};
constexpr int prompt_xinput=0;
void note_prompt_read(int){}
bool block_polled_input(){return blocked;}
struct OverlayInputAccess {OverlayInputAccess(){++overlay_input_access;}~OverlayInputAccess(){--overlay_input_access;}};
struct Hooks {std::array<int,1>xinput_front{},xinput_extended{},xinput_state{};};
Hooks& input_hooks(){static Hooks h;return h;}
DWORD native_poll(DWORD,XINPUT_STATE* out){++reads;clock_ms+=2;if(out&&read_result==ERROR_SUCCESS)*out=raw;return read_result;}
template<class T>T original(int){return native_poll;}
void filter_pad(bool outer,DWORD,XINPUT_STATE* out){if(outer&&filter_enabled){out->Gamepad.wButtons|=0x4000;out->Gamepad.sThumbLY=-4321;}++clock_ms;}
namespace arcade_mode=dingosdk::arcade_mode;
@controller_capture_front@
@controller_capture_xinput@
#undef WINAPI
}
namespace {
NativeInputFrame frame(std::uint64_t at=1000,std::uint64_t step=1){
    NativeInputFrame f{};f.valid=true;f.owner={1,2,3,4,5};f.owner_generation=7;f.contact_generation=11;f.action_generation=13;
    f.physics_step=step;f.sampled_at=at;f.state=100;f.mode=1;f.contacts=0xc000;f.flip_known=true;return f;
}
std::vector<CaptureCorrelationEvidence> drain(){
    std::vector<CaptureCorrelationEvidence> out;std::array<ClientTelemetry,64> rows{};
    const auto count=telemetry.client.take(rows);
    for(std::size_t i=0;i<count;++i)if(const auto* p=std::get_if<CaptureCorrelationEvidence>(&rows[i]))out.push_back(*p);
    return out;
}
void reset(){
    (void)drain();clock_ms=1000;mode=true;input_capture_correlation={};controller_capture_live=false;
    arcade_input.enable(false);arcade_input.enable(true);controller_route.reset();native_readiness.reset();playback_packets={};
    capture_native_frame=frame();capture_focus=capture_gameplay=capture_source_available=capture_cached_valid=true;input_clock_valid=true;
    capture_bitmap_as_read=2;capture_bitmap_readable=true;capture_source_at=1000;capture_cached_at=1000;capture_physics_dt=capture_cached_dt=.016f;capture_native_words={1,0xc000,3,4,5,6,7,8};
    arcade_input.publish_native_context(capture_native_frame);arcade_input.publish_authority(1000,7,1,true);
    native_readiness.publish(capture_native_frame,{true,true,true,true,true,true,true,true,true,3});
    controller_route.observe(1,{true,1000,0,0,0,0,0,0,0});controller_route.select(1000,2,true);
    hook::blocked=hook::filter_enabled=false;hook::read_result=0;hook::reads=hook::overlay_input_access=0;hook::raw={20,{}};
}
void begin(unsigned scope=64,unsigned duration=1000){
    check(activate(scope,duration),"finite diagnostic capture begins");
}
void hooks_and_off(){
    for(unsigned kind=0;kind<3;++kind){
        reset();begin();hook::XINPUT_STATE out{};
        const auto status=kind==0?hook::captured_front<0>(1,&out):kind==1?hook::captured_xinput<0>(1,&out):hook::captured_xinput<0,true>(1,&out);
        check(status==0&&hook::reads==1,"actual outer hook retains original status and poll count");
        auto rows=drain();check(rows.size()==2&&rows[0].kind==CaptureCorrelationKind::begin,"neutral poll creates a finite row even without a button edge");
        const auto& r=rows.back();const auto& d=r.controller;
        check(capture_correlation_valid(r)&&r.schema==3&&r.source==CaptureCorrelationSource::pad_poll,"same-poll payload uses existing capture channel and schema validation");
        check(r.native_ms==1000&&r.physics_step==1&&r.owner==1&&r.owner_generation==7,"native time/step/generation remain original, not read time");
        check(d.raw==ControllerCapturePad{0,0,0,0,0,0,0,20}&&d.returned.buttons==out.Gamepad.wButtons&&d.returned.ly==out.Gamepad.sThumbLY&&d.returned.packet==out.dwPacketNumber,"actual raw and returned full pad payloads join same call");
        check(d.slot==1&&d.selected_slot==1&&d.bitmap==2&&d.route_generation==controller_route.generation(),"route facts join the actual physical slot");
        check(d.raw_ms==1002&&d.remap_ms==1003&&d.returned_ms==1003&&d.poll_started==1000,"original hook clocks survive queue transport");
        check(d.readiness==8191-2048-1024&&d.readiness_owner==1&&d.readiness_physics_step==1&&d.readiness_native_ms==1000,"actual readiness mask and original permission proof join capture owner");
        check(d.ownership_known&&(d.ownership&1)&&d.enabled&&d.gameplay,"same-poll synthetic ownership is observed, not inferred from returned difference");
        off_capture();check(input_capture_correlation.active()&&!mode,"actual OFF capture gate preserves finite observations while gameplay is disabled");
        hook::raw.dwPacketNumber=out.dwPacketNumber;
        hook::captured_front<0>(1,&out);auto off=drain();check(off.size()==1&&!off.back().controller.enabled&&off.back().controller.ownership_known&&!off.back().controller.ownership,"OFF row observes released authority and packet ownership");
        check(off.back().controller.raw.packet!=off.back().controller.returned.packet,"retirement collision remains visible, never labeled restored");
        hook::captured_front<0>(1,&out);auto equal=drain();check(equal.size()==1&&equal[0].controller.raw==equal[0].controller.returned,"later OFF row records actual full pad and packet equality");
        input_capture_correlation.end(clock_ms,{},telemetry.client.dropped(),capture_row);auto end=drain();check(end.size()==1&&end[0].expected==3,"footer accounts every ON and OFF neutral poll");
    }
}
void observation_negatives(){
    reset();begin(96);auto obs=controller_capture_context(1000,1);CaptureCorrelationEvidence r{};r.source=CaptureCorrelationSource::native_admission;r.source_sequence=1;r.ms=1000;r.events_known=true;r.controller=obs.details;
    input_capture_correlation.observation(r,obs.proof,telemetry.client.dropped(),capture_row,obs.readiness_proof);
    auto rows=drain();check(rows.back().native_valid&&rows.back().controller.physics_dt==.016f,"joined native admission retains original physics dt");
    clock_ms=1151;capture_native_frame=frame();obs=controller_capture_context(clock_ms,1);r.ms=clock_ms;r.source_sequence=2;r.controller=obs.details;
    input_capture_correlation.observation(r,obs.proof,telemetry.client.dropped(),capture_row,obs.readiness_proof);rows=drain();
    check(rows.size()==1,"stale native context remains observable without a false validity claim");
    check(!rows.back().native_valid&&rows.back().native_ms==1000&&rows.back().controller.readiness==0&&input_capture_correlation.active(),"stale contexts are emitted without renewing native time or ending observational capture");
    capture_native_frame=frame(1200);r.ms=1152;r.source_sequence=3;r.controller=controller_capture_context(1152,1).details;
    input_capture_correlation.observation(r,capture_native_frame,telemetry.client.dropped(),capture_row);rows=drain();check(!rows.back().native_valid&&rows.back().native_ms==1200,"future original native time stays invalid");
    auto other=frame(1153,2);other.owner.rig=9;r.ms=1153;r.source_sequence=4;r.controller=controller_capture_context(1153,1).details;
    input_capture_correlation.observation(r,other,telemetry.client.dropped(),capture_row);rows=drain();check(rows.back().owner==2&&input_capture_correlation.active(),"replacement native owner receives a distinct capture-local token without electing an input source");
    for(unsigned i=0;i<17;++i){auto f=frame(1154+i,3+i);f.owner.rig=100+i;r.ms=1154+i;r.source_sequence=5+i;r.controller=controller_capture_context(r.ms,1).details;input_capture_correlation.observation(r,f,telemetry.client.dropped(),capture_row);}
    rows=drain();check(rows.back().overflow&&!rows.back().native_valid&&!rows.back().owner,"bounded owner-token exhaustion cannot claim native validity");
}
void readiness_provenance(){
    reset();auto permission=frame();permission.state=200;permission.airborne=true;
    auto current=permission;current.physics_step=2;current.sampled_at=1017;
    capture_native_frame=current;arcade_input.publish_native_context(current);
    native_readiness.publish(permission,{true,true,true,true,true,true,true,true,true,3});
    clock_ms=1017;begin(32);auto observation=controller_capture_context(clock_ms,1);
    CaptureCorrelationEvidence row;row.source=CaptureCorrelationSource::native_admission;row.source_sequence=1;row.ms=clock_ms;row.events_known=true;row.controller=observation.details;
    input_capture_correlation.observation(row,observation.proof,telemetry.client.dropped(),capture_row,observation.readiness_proof);
    auto rows=drain();const auto& r=rows.back();
    check(r.native_valid&&r.native_ms==1017&&r.physics_step==2&&r.controller.readiness_native_ms==1000&&r.controller.readiness_physics_step==1,"current native sample and older stored readiness proof keep their own original clocks and steps");
    check((r.controller.readiness&2048)&&r.controller.native_flip_known&&r.controller.native_flip==-1,"actual AIR flip readiness is joined without a requested ready flag");
    check(r.controller.cached_at==1000&&r.controller.cached_dt==.016f&&r.controller.physics_dt==.016f,"cached reader clock and original physics dt are not relabeled at delivery time");
    current.owner.rig=9;capture_native_frame=current;arcade_input.publish_native_context(current);clock_ms=1018;observation=controller_capture_context(clock_ms,1);
    row.source_sequence=2;row.ms=clock_ms;row.controller=observation.details;
    input_capture_correlation.observation(row,observation.proof,telemetry.client.dropped(),capture_row,observation.readiness_proof);rows=drain();
    check(rows.back().owner==2&&rows.back().controller.readiness_owner==1&&!rows.back().controller.readiness,"same-generation different native owner cannot inherit readiness or capture-local identity");
    clock_ms=1167;capture_native_frame=current;observation=controller_capture_context(clock_ms,1);row.source_sequence=3;row.ms=clock_ms;row.controller=observation.details;
    input_capture_correlation.observation(row,observation.proof,telemetry.client.dropped(),capture_row,observation.readiness_proof);rows=drain();check(rows.back().native_valid,"original native freshness includes exact150ms boundary");
    clock_ms=1168;observation=controller_capture_context(clock_ms,1);row.source_sequence=4;row.ms=clock_ms;row.controller=observation.details;
    input_capture_correlation.observation(row,observation.proof,telemetry.client.dropped(),capture_row,observation.readiness_proof);rows=drain();check(!rows.back().native_valid&&rows.back().native_ms==1017,"151ms delivery cannot renew original native freshness");
}
void binding_context(){
    reset();controller_route.arm(1,1000,1000);
    const ArcadeInput::Physical pad{true,1000,0,0,0,0,0,0,0};controller_route.observe_unfiltered(1,pad);controller_route.observe(1,pad);
    controller_route.select(1000,3,true,capture_native_frame);capture_bitmap_as_read=3;capture_bitmap_readable=true;
    begin(32);auto observation=controller_capture_context(1000,1);CaptureCorrelationEvidence row{};row.source=CaptureCorrelationSource::native_admission;row.source_sequence=1;row.ms=1000;row.events_known=true;row.controller=observation.details;
    input_capture_correlation.observation(row,observation.proof,telemetry.client.dropped(),capture_row,observation.readiness_proof,observation.binding_proof);
    auto rows=drain();const auto& d=rows.back().controller;
    check(d.binding_state==2&&d.binding_deadline==2000&&d.binding_armed==1000&&d.binding_owner==1&&d.binding_observed,"actual explicit binding state, finite deadline and capture-local proof owner are joined");
    check(d.binding_owner_generation==7&&d.binding_contact_generation==11&&d.binding_action_generation==13&&d.binding_physics_step==1&&d.binding_native_ms==1000,"binding observer retains its actual generation/time/step domain");
    capture_source_available=false;controller_route.select(1001,3,false);observation=controller_capture_context(1001,1);
    check(observation.details.bitmap_as_read==3&&observation.details.bitmap_readable&&!observation.details.bitmap_known&&!observation.details.source_available,"bitmap as read is retained separately from unavailable source qualification");
    auto bad=rows.back();bad.controller.bitmap_as_read=256;check(!capture_correlation_valid(bad),"unsupported source identifiers cannot leak into the bitmap observation");
}
void tickets_and_loss(){
    reset();begin();ControllerPollCapture pending{};check(begin_controller_poll(1,pending),"finite capture reserves same-call ticket");
    input_capture_correlation.end(1001,capture_native_frame,telemetry.client.dropped(),capture_row);auto rows=drain();check(rows.back().expected==1&&!rows.back().complete&&!rows.back().events_known,"in-flight call at stop is explicitly counted as missing evidence");
    const auto old=pending.capture_id;clock_ms=1002;begin();check(input_capture_correlation.capture_id()!=old,"capture IDs do not alias across restart");
    pending.details.returned_ms=1003;complete_controller_poll(pending);rows=drain();check(rows.size()==1,"late completion cannot join another capture");
    for(unsigned i=0;i<64;++i)check(input_capture_correlation.reserve_poll()!=0,"bounded pending-ticket capacity is usable");
    check(!input_capture_correlation.reserve_poll(),"pending overflow fails closed");input_capture_correlation.end(1004,capture_native_frame,telemetry.client.dropped(),capture_row);rows=drain();check(rows.back().expected==65&&rows.back().overflow&&!rows.back().complete,"overflow and outstanding calls survive footer accounting");
    reset();begin();ControllerPollCapture p{};check(begin_controller_poll(1,p),"expiry control starts an actual poll");p.details.raw_ms=1000;p.details.returned_ms=2001;complete_controller_poll(p);rows=drain();check(!input_capture_correlation.active()&&!rows.back().complete&&rows.back().expected==1,"late return cannot extend finite duration or hide pending debt");
    reset();begin();const auto id=input_capture_correlation.capture_id();const auto first=input_capture_correlation.reserve_poll(),second=input_capture_correlation.reserve_poll();
    CaptureCorrelationEvidence event;event.source=CaptureCorrelationSource::pad_poll;event.ms=1000;event.events_known=true;
    event.controller=controller_capture_context(1000,1).details;event.controller.poll_started=event.controller.raw_ms=event.controller.returned_ms=1000;
    check(input_capture_correlation.release_poll(id,second),"later pending call has its own ticket");event.source_sequence=second;input_capture_correlation.observation(event,capture_native_frame,telemetry.client.dropped(),capture_row);
    check(input_capture_correlation.release_poll(id,first),"earlier pending call remains independently correlated");event.source_sequence=first;input_capture_correlation.observation(event,capture_native_frame,telemetry.client.dropped(),capture_row);rows=drain();
    check(rows.back().overflow,"out-of-order call completion cannot silently claim ordered capture completeness");
    check(!input_capture_correlation.release_poll(id,first),"duplicate completion cannot consume another call's reservation");
    reset();begin();clock_ms=999;input_capture_correlation.maintain(clock_ms,{},telemetry.client.dropped(),capture_row);rows=drain();check(!input_capture_correlation.active()&&!rows.back().complete,"clock rollback terminates capture incompletely");
}
void footer_and_validation(){
    for(unsigned loss=0;loss<5;++loss){
        reset();begin(96);if(loss==4)capture_native_frame.valid=false;
        auto context=controller_capture_context(1000,1);CaptureCorrelationEvidence row{};
        row.source=CaptureCorrelationSource::native_admission;row.source_sequence=1;row.ms=1000;row.events_known=true;row.controller=context.details;
        input_capture_correlation.observation(row,context.proof,telemetry.client.dropped(),capture_row,context.readiness_proof);
        off_capture();hook::XINPUT_STATE out{};hook::captured_front<0>(1,&out);
        if(loss==2)telemetry.client.lose();
        input_capture_correlation.end(clock_ms,{},telemetry.client.dropped(),capture_row);
        auto rows=drain();check(rows.size()==4,"capture boundary and both diagnostic sources remain on one bounded channel");
        CaptureCorrelationDrain sink;
        for(std::size_t i=0;i<rows.size()-1;++i)sink.written(rows[i],!((loss==1&&i==1)||(loss==3&&i==0)));
        auto footer=sink.footer(rows.back(),telemetry.client.dropped());
        check(capture_correlation_valid(footer),"actual drain finalizes a valid schema3 footer");
        check(capture_correlation_complete(footer)==(loss==0||loss==4),"sink rejection, missing begin and queue loss prevent completeness; invalid context alone does not fabricate evidence loss");
        if(loss==4)check(!rows[1].native_valid&&!rows[2].native_valid&&!footer.native_valid,"complete observational transport never upgrades invalid native context");
        auto bad=rows[2];bad.controller.raw_ms=bad.controller.returned_ms+1;
        check(!capture_correlation_valid(bad),"same-poll clock correlation rejects raw time after actual return");
        bad=rows[2];bad.controller.remap_ms=bad.controller.raw_ms-1;
        check(!capture_correlation_valid(bad),"same-poll remap must follow original observation");
        bad=rows[2];bad.controller.readiness_owner=17;
        check(!capture_correlation_valid(bad),"readiness owner tokens cannot expose unbounded identifiers");
    }
    reset();check(!activate(96,0)&&!controller_capture_live,"failed activation cannot leave a live capture gate");
    begin();const auto capture=input_capture_correlation.capture_id();check(!activate(96,1000)&&controller_capture_live&&input_capture_correlation.capture_id()==capture,"a rejected overlapping request preserves the original capture gate and identity");
    reset();mode=false;capture_native_frame={};begin(96);auto rows=drain();
    check(!rows[0].native_valid&&!rows[0].owner&&input_capture_correlation.active(),"finite observational begin can describe OFF and missing native owner without admitting input");
}
void unchanged_and_invalid(){
    for(unsigned kind=0;kind<3;++kind)for(bool capture_enabled:{false,true})for(bool blocked:{false,true})for(bool filter:{false,true}){
        reset();if(capture_enabled)begin();hook::blocked=blocked;hook::filter_enabled=filter;hook::raw={22,{0x1000,12,34,111,222,333,444}};hook::XINPUT_STATE out{};
        if(kind==0)hook::captured_front<0>(0,&out);else if(kind==1)hook::captured_xinput<0>(0,&out);else hook::captured_xinput<0,true>(0,&out); // Wrong source: native remapper rejects it.
        check(out.Gamepad.wButtons==(blocked?0:static_cast<unsigned short>(filter?0x5000:0x1000))&&out.Gamepad.sThumbLY==(blocked?0:filter?-4321:222),"diagnostics do not change capture/filter/native payload behavior");
        check(out.dwPacketNumber==(blocked?(22u^0x80000000u):22u),"inactive/active diagnostics preserve the actual returned native packet");
        auto rows=drain();check(rows.size()==(capture_enabled?2u:0u),"no diagnostic rows are emitted outside explicit finite capture");
        if(capture_enabled)check(rows.back().controller.raw.buttons==0x1000&&rows.back().controller.raw.ly==222,"pre-filter original values remain distinct from filtered returned values");
    }
    reset();begin();hook::read_result=hook::ERROR_DEVICE_NOT_CONNECTED;hook::XINPUT_STATE out{};
    check(hook::captured_front<0>(1,&out)==hook::ERROR_DEVICE_NOT_CONNECTED,"failed native read status is untouched");auto rows=drain();
    check(rows.back().controller.poll_result==1167&&!rows.back().controller.raw_valid&&!rows.back().controller.returned_valid&&!rows.back().controller.ownership_known,"failed reads record unavailable payload and ownership, never invented neutral restoration");
    reset();begin();hook::overlay_input_access=1;hook::captured_front<0>(1,&out);rows=drain();check(rows.size()==1,"nested reads cannot duplicate an outer capture ticket");hook::overlay_input_access=0;
}
void compact_selected_polls(){
    reset();begin(103);auto rows=drain();check(rows.size()==1,"compact capture keeps its original begin");
    auto details=controller_capture_context(1000,1).details;
    details.raw_valid=details.returned_valid=details.ownership_known=true;
    details.poll_started=details.raw_ms=details.remap_ms=details.returned_ms=1000;
    auto poll=[&](ControllerCaptureDetails d,NativeInputFrame proof){
        clock_ms=d.returned_ms;ControllerPollCapture capture{};
        check(begin_controller_poll(d.slot,capture),"each compact candidate reserves a real hook ticket");
        capture.proof=proof;capture.readiness_proof=proof;capture.details=d;
        complete_controller_poll(capture);return drain();
    };
    auto emitted=poll(details,frame());check(emitted.size()==1&&emitted[0].source_sequence==1,"first selected source emits");
    for(unsigned i=1;i<20;++i){
        auto churn=details;churn.raw.packet=i;churn.returned.packet=100+i;
        churn.poll_started=churn.raw_ms=churn.remap_ms=churn.returned_ms=1000+i;
        churn.source_ms=churn.cached_at=churn.readiness_native_ms=churn.current_native_ms=1000+i;
        churn.readiness_physics_step=churn.current_physics_step=i+1;
        check(poll(churn,frame()).empty(),"packet and publication-clock churn alone emits no compact row");
    }
    details.poll_started=details.raw_ms=details.remap_ms=details.returned_ms=1020;
    details.raw.buttons=0x4000;details.raw.packet=21;details.returned.packet=121;
    emitted=poll(details,frame());check(emitted.size()==1&&emitted[0].source_sequence==2&&
        emitted[0].controller.raw.packet==21&&emitted[0].controller.returned.packet==121,"same-step X press retains exact raw and returned packet values");
    details.poll_started=details.raw_ms=details.remap_ms=details.returned_ms=1048;details.raw.buttons=0;
    emitted=poll(details,frame());check(emitted.size()==1&&emitted[0].source_sequence==3,"same-step28ms X release is not coalesced");
    for(const auto& pair:{std::pair<short,short>{-13847,-29696},{28377,16383},{0,0}}){
        details.returned.rx=pair.first;details.returned.ry=pair.second;
        emitted=poll(details,frame());check(emitted.size()==1,"each setup/flick/neutral payload change emits in one physics step");
    }
    auto next=frame(1048,2);emitted=poll(details,next);
    check(emitted.size()==1&&emitted[0].physics_step==2,"unchanged payload emits once for a new original physics step");
    check(poll(details,next).empty(),"same step representative is not emitted twice");
    // Each component of both pad payloads and the ownership/validity/context
    // key has a direct same-step control, independent of packet churn.
    for(unsigned field=0;field<36;++field){
        auto changed=details;
        switch(field){
        case 0:changed.raw.lx=1;break;case 1:changed.raw.ly=1;break;case 2:changed.raw.rx=1;break;case 3:changed.raw.ry=1;break;
        case 4:changed.raw.lt=1;break;case 5:changed.raw.rt=1;break;case 6:changed.returned.buttons=1;break;
        case 7:changed.returned.lx=1;break;case 8:changed.returned.ly=1;break;case 9:changed.returned.lt=1;break;case 10:changed.returned.rt=1;break;
        case 11:changed.ownership=1;break;case 12:changed.phase=1;break;case 13:changed.poll_result=1167;break;
        case 14:changed.raw_valid=false;break;case 15:changed.returned_valid=false;break;case 16:changed.ownership_known=false;break;
        case 17:changed.enabled=false;break;case 18:changed.focus=false;break;case 19:changed.gameplay=false;break;
        case 20:changed.clock_valid=false;break;case 21:changed.bitmap_known=false;changed.bitmap=0;break;
        case 22:changed.source_available=false;break;case 23:changed.capture_blocked=true;break;
        case 24:changed.native_observed=false;break;case 25:changed.native_flip_known=false;break;
        case 26:changed.readiness_observed=false;break;case 27:changed.current_observed=false;break;
        case 28:changed.cached_dt_valid=false;break;case 29:++changed.readiness;break;case 30:++changed.native_mode;break;
        case 31:++changed.native_state;break;case 32:++changed.native_contacts;break;case 33:++changed.native_flip;break;
        case 34:++changed.native_words[0];break;case 35:++changed.route_generation;break;
        }
        auto changed_proof=next;if(field==24)changed_proof.valid=false;
        const auto changed_rows=poll(changed,changed_proof);
        if(changed_rows.size()!=1)std::cerr<<"compact field="<<field<<'\n';
        check(changed_rows.size()==1,"meaningful same-step payload or context change emits");
        check(poll(details,next).size()==1,"restoration of meaningful context emits separately");
    }
    auto other=next;other.owner.rig=99;emitted=poll(details,other);
    check(emitted.size()==1&&emitted[0].owner==2,"replacement owner is a distinct observation, never borrowed authority");
    auto unknown=other;unknown.valid=false;emitted=poll(details,unknown);
    check(emitted.size()==1&&!emitted[0].native_valid,"native validity withdrawal emits without a false validity claim");
    details.slot=0;emitted=poll(details,unknown);check(emitted.empty(),"unselected polling does not consume compact row budget");
    details.selected_slot=0;emitted=poll(details,unknown);check(emitted.size()==1,"new selected source emits its actual payload");
    details.slot=1;emitted=poll(details,unknown);check(emitted.size()==1,"previous selected source withdrawal survives selection change");
    check(poll(details,unknown).empty(),"withdrawn source does not become a second full-poll stream");
    details.slot=0;details.selected_slot=4;details.enabled=false;details.gameplay=false;details.ownership=0;
    emitted=poll(details,unknown);check(emitted.size()==1&&!emitted[0].controller.enabled,"OFF and selected-source disappearance retain the previous source withdrawal");
    input_capture_correlation.end(clock_ms,unknown,telemetry.client.dropped(),capture_row);rows=drain();
    check(rows.size()==1&&rows[0].complete&&!rows[0].overflow,"suppressed unchanged/unselected tickets create no missing debt");
}
void compact_accounting(){
    {
        reset();begin(103);ControllerPollCapture c{};check(begin_controller_poll(1,c),"closed compact control reserves a poll");
        c.proof=frame();c.details=controller_capture_context(1000,1).details;
        c.details.poll_started=c.details.raw_ms=c.details.returned_ms=1000;complete_controller_poll(c);
        for(const auto source:{CaptureCorrelationSource::input,CaptureCorrelationSource::recognition,
                CaptureCorrelationSource::native,CaptureCorrelationSource::native_admission}){
            CaptureCorrelationEvidence row;row.source=source;row.source_sequence=1;row.ms=1000;row.events_known=true;
            row.controller=controller_capture_context(1000,1).details;
            if(source==CaptureCorrelationSource::recognition){row.recognition_id=row.recognition_session=1;
                row.action=3;row.context=2;row.footprint_kind=2;row.recognized_ms=1000;}
            input_capture_correlation.observation(row,frame(),telemetry.client.dropped(),capture_row);
        }
        auto rows=drain();input_capture_correlation.end(1000,frame(),telemetry.client.dropped(),capture_row);auto end=drain();
        CaptureCorrelationDrain consumer;for(const auto& row:rows)consumer.written(row,true);
        check(rows.size()==6&&end.size()==1,"closed103 fixture contains begin and all five required sources");
        const auto footer=consumer.footer(end[0],telemetry.client.dropped());
        check(capture_correlation_complete(footer)&&footer.expected==5&&footer.drained==5&&!footer.dropped,
            "existing formatter/drain completeness accounts compact source7 and unchanged other sources together");
    }
    for(unsigned count:{224u,225u}){
        reset();begin(103);auto begin_row=drain();std::vector<CaptureCorrelationEvidence> rows=begin_row;
        for(unsigned i=0;i<count;++i){
            clock_ms=1000+i;ControllerPollCapture c{};check(begin_controller_poll(1,c),"bounded capture reserves all completed polls");
            c.proof=frame(clock_ms,i+1);c.details=controller_capture_context(clock_ms,1).details;
            c.details.poll_started=c.details.raw_ms=c.details.remap_ms=c.details.returned_ms=clock_ms;
            c.details.raw.buttons=static_cast<std::uint16_t>(i&1u);complete_controller_poll(c);
            auto part=drain();rows.insert(rows.end(),part.begin(),part.end());
        }
        input_capture_correlation.end(clock_ms,{},telemetry.client.dropped(),capture_row);auto end=drain();
        check(rows.size()==225&&end.size()==1,"exact224 compact rows is the hard output bound");
        for(unsigned i=1;i<rows.size();++i)check(rows[i].ordinal==i&&rows[i].source_sequence==i,"compact row and global ordinal sequences are contiguous without ticket gaps");
        check(end[0].expected==count&&end[0].complete==(count==224)&&end[0].events_known==(count==224)&&end[0].overflow==(count==225),
            "225th selected observation is counted once as loss, never silent truncation");
    }
    for(unsigned fault=0;fault<8;++fault){
        reset();begin(103);(void)drain();ControllerPollCapture first{},second{};
        check(begin_controller_poll(1,first)&&begin_controller_poll(1,second),"two distinct pending tickets reserve");
        first.proof=second.proof=frame();first.details=second.details=controller_capture_context(1000,1).details;
        first.details.poll_started=first.details.raw_ms=first.details.returned_ms=1000;second.details=first.details;
        if(fault==0){complete_controller_poll(second);complete_controller_poll(first);}
        if(fault==1){complete_controller_poll(first);complete_controller_poll(first);complete_controller_poll(second);}
        if(fault==2){complete_controller_poll(first);} // Outstanding debt at footer.
        if(fault==3){first.details.returned_ms=2001;complete_controller_poll(first);}
        if(fault==4){first.details.returned_ms=999;complete_controller_poll(first);}
        if(fault==5){for(unsigned i=0;i<64;++i)telemetry.client.push(ClientTelemetry{Observation{}});complete_controller_poll(first);complete_controller_poll(second);}
        if(fault==6){first.details.raw_ms=1001;complete_controller_poll(first);complete_controller_poll(second);}
        if(fault==7){first.details.poll_started=first.details.raw_ms=first.details.remap_ms=first.details.returned_ms=1010;
            second.details.poll_started=second.details.raw_ms=second.details.remap_ms=second.details.returned_ms=1005;
            complete_controller_poll(first);complete_controller_poll(second);}
        auto events=drain();input_capture_correlation.end(1000,{},telemetry.client.dropped(),capture_row);auto end=drain();
        if(end.empty())end=events;
        check(!end.empty()&&end.back().kind==CaptureCorrelationKind::end&&!end.back().complete,
            "reversed/duplicate/pending/late/rollback/queue-loss/invalid-clock compact captures cannot claim completeness");
    }
    for(unsigned scope:{64u,96u,255u}){
        reset();begin(scope);(void)drain();hook::XINPUT_STATE output{};
        for(unsigned i=0;i<3;++i){hook::captured_front<0>(1,&output);const auto r=drain();
            check(r.size()==1&&r[0].source_sequence==i+1,"full legacy and schema4 scopes retain every poll and ticket sequence");}
    }
}
void compact_hook_invariance(){
    for(unsigned kind=0;kind<3;++kind)for(unsigned slot:{0u,1u})for(bool blocked:{false,true})for(bool filter:{false,true}){
        const auto run=[&](bool capture){
            reset();if(capture)begin(103);hook::blocked=blocked;hook::filter_enabled=filter;
            hook::raw={22,{0x1000,12,34,111,222,333,444}};hook::XINPUT_STATE out{};
            const auto result=kind==0?hook::captured_front<0>(slot,&out):kind==1?hook::captured_xinput<0>(slot,&out):hook::captured_xinput<0,true>(slot,&out);
            check(result==0&&hook::reads==1,"compact observation does not add a native poll or change its status");
            return out;
        };
        const auto before=run(false),after=run(true);const auto& a=before.Gamepad;const auto& b=after.Gamepad;
        check(before.dwPacketNumber==after.dwPacketNumber&&a.wButtons==b.wButtons&&a.bLeftTrigger==b.bLeftTrigger&&
            a.bRightTrigger==b.bRightTrigger&&a.sThumbLX==b.sThumbLX&&a.sThumbLY==b.sThumbLY&&a.sThumbRX==b.sThumbRX&&a.sThumbRY==b.sThumbRY,
            "compact observation leaves every final returned payload and packet component unchanged");
    }
}
}
void run_controller_capture_tests(){
    input_telemetry.publish(telemetry);hooks_and_off();observation_negatives();readiness_provenance();binding_context();tickets_and_loss();footer_and_validation();unchanged_and_invalid();compact_selected_polls();compact_accounting();compact_hook_invariance();
    std::cout<<checks<<" production controller capture checks passed\n";
}
