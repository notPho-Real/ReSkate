unsigned checks{};void check(bool b,const char* why){++checks;if(!b){std::cerr<<why<<'\n';std::exit(1);}}
bool same(const PhysicalBalanceSample& a,const PhysicalBalanceSample& b){return a.valid==b.valid&&a.active==b.active&&a.exit==b.exit&&std::abs(a.position-b.position)<=1e-6f&&std::abs(a.velocity-b.velocity)<=1e-6f&&std::abs(a.elapsed-b.elapsed)<=1e-6f&&std::abs(a.repeat_pressure-b.repeat_pressure)<=1e-6f;}
auto snapshot(){auto copy=physical_manual;return copy.sample(.001f,PhysicalManualControl{});}
void client(float seconds,const ScoreLabelOccurrence& label){
#if defined(DINGOSDK_MANUAL_LIFECYCLE_HUD)
 if(hud_hz)seconds=1.f/hud_hz;
#endif
 update_combo(raw,owner,ControllerInput{},watch,0,clock_ms,{},label,false,seconds);
 const auto live=[&](auto& deadline){const auto at=deadline.load();return at>=clock_ms&&at-clock_ms<=150;};
 native_readiness.publish(latest,{active&&watch,raw.state==100&&raw.crouch_mode==1,false,false,false,
  live(manual_eligible_until),live(manual_prepare_until),live(manual_release_until),live(action_eligible_until),0});
}
