 {1,false,GestureContext::ground,{{0,0,-32767},{18,25000,28000},{21,0,0},{24,0,0}}},
 {16,true,GestureContext::ground,{{0,0,32767},{18,25000,-28000},{21,0,0},{24,0,0}}}}};
NativeGesture::Output remap(std::uint16_t physical_buttons=0,short physical_y=0,short physical_x=0,unsigned char physical_rt=0){
 const unsigned user=0;const auto now=clock_ms;const auto tick=now/17;NativeGesture::Output result{};
 const auto buttons=physical_buttons;short left_x=physical_x,left_y=physical_y,right_x=0,right_y=0;unsigned char left_trigger=0,right_trigger=physical_rt;
 const bool authored=true;
 arcade_input.observe_physical(user,{true,now,physical_buttons,left_x,left_y,right_x,right_y,left_trigger,right_trigger});
 const auto admission=native_readiness.sample(now,arcade_input.native_context(now));
 const bool game_input=active&&fixture_watch&&admission.gameplay,may_start=admission.start,may_push=false,may_toggle_board=false,offboard=admission.offboard;
 const auto release_deadline=manual_release_until.load();const bool releasing_manual=game_input&&admission.releasing&&release_deadline>=now&&release_deadline-now<=150;
 if(releasing_manual)arcade_input.cancel_manuals();
 const auto manual_deadline=manual_eligible_until.load();const bool manual_safe=game_input&&admission.manual&&manual_deadline>=now&&manual_deadline-now<=150;
 const auto prepare_deadline=manual_prepare_until.load();const bool manual_prepare=game_input&&admission.prepare&&prepare_deadline>=now&&prepare_deadline-now<=150;
 const auto action_experiment=ActionExperiment::classic;const bool flip_ready=admission.flip_ready,action_safe=admission.action,may_exit_grind=false;
@@POLL@@
 if(corrupt_manual_delivery)result.right_y=0;
@@DELIVERY@@
 const bool reference=false;const unsigned char physical_right_trigger=physical_rt;
@@HOP@@
 if(releasing_manual&&!result.authored_playback&&!action.owned)result.right_x=result.right_y=0;
 return result;
}
template<class T,class... Args>void reconstruct(T& object,Args&&... args){
 std::destroy_at(&object);std::construct_at(&object,std::forward<Args>(args)...);
}
void reset_case(){
 trial_hz=0;native_score_active=true;
 controller_route.reset();playback_packets={};corrupt_manual_delivery=false;
 active=true;fixture_watch=true;owner={1,2,3,4,5};reconstruct(arcade_input,true);arcade_input.enable(true);native_input_state={};motion_cleanup_state={};reset_physical_manual=false;
 physical_manual=ManualPhysics{};reconstruct(physical_manual_steps);native_readiness={};
 combo_session=ComboSession(native_combo_tuning());manual_identity={};ground_manual_balance={};manual_episode.reset();manual_hud_episode=0;manual_acquisition={};manual_release={};balance_control={};
 had_combo_owner=false;combo_tick_at=0;clock_ms=1000;presenters={};labels={};rows.clear();manual_balance_admitted=false;
#if defined(DINGOSDK_MANUAL_LIFECYCLE_HUD)
 hud_frame=0;publish_balance_hud({},0,{});
#endif
}
void tick(unsigned dt,unsigned state,unsigned contacts,bool valid=true){
#if defined(DINGOSDK_MANUAL_LIFECYCLE_HUD)
 if(hud_hz)clock_ms=1000+std::uint64_t{++hud_frame}*1000/hud_hz;else
#endif
 advance_trial(dt);
 observe(dt/1000.f,contacts,state,valid);client(dt/1000.f,history());
}
void prepare_air(bool nose,unsigned dt){
 reset_case();observe(dt/1000.f,0xc000);client(dt/1000.f,history());remap();
 tick(dt,100,0xc000);const auto setup=remap(0x1000);check(setup.jump.setup_started&&setup.requested_id==1,"actual facade accepts ordinary Ollie setup on qualified ordinary ground");
 for(unsigned i=0;i<3;++i){tick(dt,103,0xc000);remap(0x1000);}
 tick(dt,103,0xc000);const auto release=remap();check(release.jump.released&&release.jump.setup_admitted,"actual facade carries one physical release after accepted ordinary setup");
 bool ended{};for(unsigned i=0;i<100;++i){tick(dt,200,0);const auto output=remap();if(!output.authored_playback){ended=true;break;}}
 check(ended,"existing authored playback finishes before independent Manual preparation");
 tick(dt,200,0);remap(nose?2u:1u);tick(dt,200,0);const auto request=remap(nose?1u:2u);
 check(request.manual.owns&&request.manual.request==(nose?1:-1),"actual airborne directional pair requests bounded Manual/Nose hold through existing facade");
 check(!manual_balance_admitted.load()&&!balance_hud_pending(),"airborne input delivery alone cannot admit balance or HUD");
}

std::uint64_t provisional_ground(bool nose,bool retire_contact=true){
  reset_case();native_score_active=false;
  observe(.034f,0xc000);client(.034f,history());remap();
  tick(34,100,0xc000);remap(0,nose?-32767:32767);
  for(unsigned i=0;i<7;++i){tick(34,100,0xc000);remap(0,nose?-32767:32767);}
  tick(34,100,0xc000);const auto start=remap(0,nose?32767:-32767);
  check(start.manual.owns,"actual production pair starts the original ground acquisition");
  const auto began=start.manual.request_at;const auto wanted=nose?0x8000u:0x4000u;
  for(unsigned i=0;i<9;++i){tick(34,100,0xc000);remap();}
  NativeGesture::Output touched;
  for(unsigned i=0;i<3;++i){tick(34,100,wanted);touched=remap();}
  check(touched.manual.owns&&touched.manual.confirmed,"first contact retains the existing physical-match diagnostic during initial acquisition");
  if(!retire_contact)return began;
  for(unsigned i=0;i<5;++i){tick(34,100,0xc000);const auto out=remap();
   check(out.manual.owns&&out.manual.request_at==began,"initial ground acquisition survives transient contact retirement without renewing1200ms");}
  check(!manual_balance_admitted.load()&&!balance_hud_pending(),"retired first contact cannot retain balance or HUD during reacquisition");
  return began;
}
void initial_ground_acquisition(){
 for(bool nose:{true,false}){
  const auto began=provisional_ground(nose);const auto wanted=nose?0x8000u:0x4000u;
  while(clock_ms-began<800){tick(34,100,0xc000);const auto out=remap();
   check(out.manual.owns&&out.manual.request_at==began,"initial ground acquisition survives transient contact retirement without renewing1200ms");}
  rows.push_back({901,902,nose?2u:1u});tick(34,100,wanted);const auto established=remap();
  check(established.manual.owns&&established.manual.confirmed&&established.manual.request_at==began,
        "fresh independent history and matching contact establish the original still-live actor");
  check(manual_balance_admitted.load()&&balance_hud_pending(),"late independent native entry admits balance once within original acquisition");
  for(unsigned i=0;i<5;++i){tick(34,100,0xc000);remap();}
  check(!remap().manual.owns&&!manual_balance_admitted.load()&&!balance_hud_pending(),
        "an independently established native exit retains immediate retirement after contact grace");
 }
 for(bool nose:{true,false}){
  const auto began=provisional_ground(nose,false);const auto wanted=nose?0x8000u:0x4000u;
  while(clock_ms-began<1400){const auto state=snapshot();tick(34,100,wanted);
   const auto out=remap(0,state.velocity>0?25000:-25000);
   check(out.manual.owns&&out.manual.confirmed&&manual_balance_admitted.load(),
         "continuously admitted corrected contact retains its existing hold beyond1200 without history");}
 }
 for(bool nose:{true,false}){
  provisional_ground(nose,false);const auto wanted=nose?0x8000u:0x4000u;
  rows.push_back({905,906,nose?2u:1u});tick(34,100,wanted);remap();
  for(unsigned i=0;i<5;++i){tick(34,100,0xc000);remap();}
  check(!remap().manual.owns&&!manual_balance_admitted.load()&&!balance_hud_pending(),
        "independent history during first contact establishes native exit without being swallowed as a new baseline");
 }
 for(bool nose:{true,false}){
  const auto began=provisional_ground(nose);const auto wanted=nose?0x8000u:0x4000u;
  for(unsigned i=0;i<3;++i){tick(34,100,wanted);const auto out=remap();
   check(out.manual.owns&&out.manual.request_at==began&&!manual_balance_admitted.load()&&!balance_hud_pending(),
         "spent first contact cannot invent a second balance admission without independent history");}
 }
 for(bool nose:{true,false}){
  const auto began=provisional_ground(nose);
  while(clock_ms-began<1200){tick(34,100,0xc000);remap();}
  check(!remap().manual.owns,"provisional touch never renews the original1200ms acquisition deadline");
  rows.push_back({911,912,nose?2u:1u});tick(34,100,nose?0x8000u:0x4000u);
  check(!remap().manual.owns,"late independent history cannot restart the expired actuator without a fresh physical request");
 }
 for(bool nose:{true,false})for(unsigned loss=0;loss<10;++loss){
  provisional_ground(nose,false);
  if(loss==0)++owner.rig;
  if(loss==1)fixture_watch=false;
  if(loss==2){active=false;arcade_input.enable(false);}
  if(loss==3){clock_ms+=151;client(.034f,history());check(!remap().manual.owns,"stale initial owner cannot retain acquisition");continue;}
  const auto prior=raw.words[0];if(loss==4)raw.words[0]|=0x40u;
  const auto contacts=loss==5?(nose?0x4000u:0x8000u):loss==4?0xc000u:(nose?0x8000u:0x4000u);
  const auto state=loss==6?200u:loss==7?300u:loss==8?401u:100u;
  tick(34,state,state==100?contacts:0,loss!=9);const auto out=remap();raw.words[0]=prior;
  check(!out.manual.owns,"positive owner/focus/OFF/push/opposite/air/bail/rail/validity loss retires provisional contact immediately");
 }
 for(bool nose:{true,false})for(bool failure:{false,true}){
  provisional_ground(nose,false);
  const auto endpoint=GameplayProfile{}.balance(PhysicalBalanceKind::manual).endpoint;
  const auto snap=snapshot();
  const bool want_negative=nose?failure:!failure;
  const auto sign=snap.position<0?-1.f:1.f;
  ManualBalanceAdjustment adjustment;adjustment.lean_multiplier=want_negative?-sign:sign;
  adjustment.lean_add_signed=endpoint*2;
  check(physical_manual.adjust(adjustment),"controlled endpoint seam applies to the actual provisional physical model");
  tick(34,100,nose?0x8000u:0x4000u);const auto out=remap();
  check(!out.manual.owns,"native-admitted putdown or failure always overrides initial acquisition preservation");
 }
}

// Camera phase/snapshot availability is controlled here. Native camera lease
// and ownership checks are also exercised by the runtime composition suite.
bool camera_publish_input=true,camera_override_input=false;
unsigned camera_selected_slot{};
ArcadeInput::Physical camera_selected_pad{};
std::function<void()> camera_capture_hook;
namespace dingosdk::multiplayer {
struct CameraUI { bool available=true,in_menu=false; } camera_ui;
