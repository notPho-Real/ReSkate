// Real mutex with an optional deterministic contention seam. The try-lock
// control reports only after its failed attempt; blocking lock reports before
// waiting, so the producer can publish and release without sleeps or polling.
struct CameraTestMutex {
 std::mutex mutex;std::atomic<bool>* attempted{};
 void lock(){if(attempted)attempted->store(true);mutex.lock();}
 bool try_lock(){const bool acquired=mutex.try_lock();if(attempted)attempted->store(true);return acquired;}
 void unlock(){mutex.unlock();}
} ollie_mutex;
