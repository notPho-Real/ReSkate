bool client_authority_phase(NativeRequestSample native,bool permitted=true){
 const auto now=clock_ms;const auto native_owner=owner;
 bool gameplay=permitted,focus_available=permitted;
 struct{bool valid=true;}watch;
 struct{bool available=true,in_menu=false;}ui;
 ControllerInput input;const auto controller_generation=controller_route.generation();
@@CLIENT_AUTHORITY@@
 (void)client_frame;return deferred_phase;
}
void camera_client_phase(){
 camera_adapter_ready=true;camera_input={};camera_publish_input=false;camera_override_input=false;
 set_enabled(false,false);on_camera_tick(1,6,true,true);set_enabled(true,false);
 controller_route.reset();native_input_state={};owner={1,2,3,4,5};clock_ms=1000;
 NativeRequestSample original{};original.valid=true;original.state=100;original.crouch_mode=1;original.words[1]=0xc000;
 auto frame=native_input_state.observe(clock_ms,input_owner(owner),original,{true,1,16});
 arcade_input.publish_native_context(frame);arcade_input.publish_authority(clock_ms,frame.owner_generation,1,true);
 controller_route.observe(0,{true,clock_ms,0,0,0,0,0,0,0});controller_route.select(clock_ms,1,true,frame);
 on_camera_tick(1,6,true,true);check(camera_lease_requested,"phase fixture acquires existing camera adapter once");
 for(unsigned state:{103u,200u,201u,100u}){
  clock_ms+=8;auto next=original;next.state=state;next.crouch_mode=state==100?1:state==201?2:0;next.words[1]=state<200?0xc000:0;
  const auto events=camera_events.size();const auto deadline=gameplay_valid_until.load();
  (void)client_authority_phase(next);
  on_camera_tick(1,6,true,true);
  check(camera_lease_requested&&camera_events.size()==events+1&&camera_events.back()=='A',
        "a fresh client-ahead takeoff phase must not retire the current camera lease");
  check(gameplay_valid_until.load()==deadline,"deferred client phase cannot renew existing gameplay time");
  clock_ms+=25;frame=native_input_state.observe(clock_ms,input_owner(owner),next,{true,1,16});
  arcade_input.publish_native_context(frame);controller_route.observe(0,{true,clock_ms,0,0,0,0,0,0,0});
  check(!client_authority_phase(next),"only matching original physics restores full client publication");
  on_camera_tick(1,6,true,true);check(camera_lease_requested,"matching physical phase preserves the same camera owner");
 }
 clock_ms+=8;check(!client_authority_phase(original,false),"actual focus withdrawal is never deferred");
 on_camera_tick(1,6,true,true);check(!camera_lease_requested&&camera_events.back()=='R',"focus withdrawal still restores the native camera immediately");
 camera_publish_input=true;controller_route.reset();
}
void camera_toggle(bool value){
 set_enabled(value,false);
}
void camera_routing_lifecycle(){
 camera_publish_input=true;camera_override_input=true;camera_selected_slot=0;
 camera_toggle(false);on_camera_tick(1,6,true,true);camera_toggle(true);
 camera_selected_pad={true,clock_ms,0,0,0,0,0,0,0};camera_input={};
 on_camera_tick(1,6,true,true);const auto baseline=last_camera_transform;
 clock_ms+=17;camera_selected_pad.at=clock_ms;camera_input.right_x=32767;
 on_camera_tick(1,6,true,true);
 check(last_camera_transform==baseline,"unselected merged overlay axes cannot rotate the local camera");
 clock_ms+=17;camera_selected_pad.at=clock_ms;camera_selected_pad.rx=25000;camera_input.right_x=0;
 on_camera_tick(1,6,true,true);
 check(last_camera_transform!=baseline,"selected physical axis controls the camera independently of merged overlay axes");
 clock_ms+=17;camera_selected_slot=1;camera_selected_pad.at=clock_ms;camera_selected_pad.rx=0;
 on_camera_tick(1,6,true,true);
 check(last_camera_transform==baseline,"source reassignment retires the old orbit before a fresh source acquires");
 camera_publish_input=false;arcade_input.invalidate_authority();controller_route.clear();
 on_camera_tick(1,6,true,true);
 check(!camera_lease_requested&&camera_events.back()=='R',"withdrawn gameplay authority retires camera ownership");
 controller_route.reset();camera_publish_input=true;camera_selected_pad.at=clock_ms;
 on_camera_tick(1,6,true,true);
 check(camera_lease_requested,"fresh selected source and native owner can reacquire");
 camera_publish_input=false;clock_ms+=151;on_camera_tick(1,6,true,true);
 check(!camera_lease_requested,"camera reading cannot renew stale source or native evidence");
 camera_publish_input=true;camera_selected_pad.at=clock_ms;on_camera_tick(1,6,true,true);
 const auto before_capture=camera_events.size();
 camera_capture_hook=[](){controller_route.clear();arcade_input.invalidate_authority();};
 on_camera_tick(1,6,true,true);
 check(!camera_lease_requested&&camera_events.back()=='R'&&camera_events.size()==before_capture+1,"source withdrawal during pose capture prevents transform publication");
 controller_route.reset();camera_selected_pad.at=clock_ms;on_camera_tick(1,6,true,true);
 camera_apply_hook=[](){controller_route.clear();arcade_input.invalidate_authority();};
 on_camera_tick(1,6,true,true);
 check(!camera_lease_requested&&camera_events.back()=='R',"source withdrawal during native publication retires the new lease");
 camera_toggle(false);on_camera_tick(1,6,true,true);controller_route.reset();
 camera_publish_input=true;camera_override_input=false;camera_selected_slot=0;camera_input={};
}
void camera_lifecycle(){
 for(unsigned dt:{17u,34u})for(unsigned pose:{100u,200u,401u,300u,504u})for(unsigned deferred=0;deferred<3;++deferred){
  camera_adapter_ready=true;camera_toggle(false);on_camera_tick(1,6,true,true);
  camera_events.clear();camera_input={};camera_toggle(true);on_camera_tick(1,6,true,true);
  check(camera_events==std::vector<char>{'A'},"camera phase acquires once before the OFF lifecycle boundary");
  const auto fresh=last_camera_transform;
  clock_ms+=dt;observe(dt/1000.f,pose==100?0xc000u:0u,pose);
  camera_input.right_x=25000;on_camera_tick(1,6,true,true);camera_input.right_x=0;
  check(last_camera_transform!=fresh,"pre-toggle camera orbit has retained state to retire");
  const auto before=camera_events.size();camera_toggle(false);camera_toggle(true);
  if(deferred){
   camera_adapter_ready=deferred!=1;
   on_camera_tick(1,6,true,deferred!=2);
   check(camera_events.size()==before&&camera_lease_requested,
    "unavailable native adapter or wrong camera phase retains cleanup and blocks reacquisition");
   check(camera_observed_generation!=camera_reset_generation.load(),
    "deferred camera retirement never acknowledges the toggle before cleanup succeeds");
  }
  camera_adapter_ready=true;on_camera_tick(1,6,true,true);
  check(camera_events.size()==before+2&&camera_events[before]=='R'&&camera_events[before+1]=='A',
   "OFF-to-ON between camera callbacks must retire the old native camera lease before reacquisition");
  check(last_camera_transform==fresh,"re-enabled camera starts from fresh orbit state instead of inheriting old aim");
  const auto retired=camera_events.size();clock_ms+=dt;on_camera_tick(1,6,true,true);
  check(camera_events.size()==retired+1&&camera_events.back()=='A',"acknowledged toggle cannot replay camera restoration on later phases");
  camera_toggle(false);on_camera_tick(1,6,true,true);
  check(!camera_lease_requested&&camera_events.back()=='R',"ordinary OFF relinquishes camera ownership without an ON request");
 }
 for(bool during_apply:{false,true}){
  camera_toggle(false);on_camera_tick(1,6,true,true);camera_toggle(true);on_camera_tick(1,6,true,true);
  const auto before=camera_events.size();
  auto toggle=[](){camera_toggle(false);camera_toggle(true);};
  if(during_apply)camera_apply_hook=toggle;else camera_read_hook=toggle;
  on_camera_tick(1,6,true,true);
  check(!camera_lease_requested&&camera_events.back()=='R',
   "mode toggle during camera callback must retire ownership before the callback returns");
  check(camera_events.size()==before+(during_apply?2u:1u),
   "changed camera generation cannot continue stale orbit or leave a newly raced lease active");
  const auto retired=camera_events.size();on_camera_tick(1,6,true,true);
  check(camera_events.size()==retired+1&&camera_events.back()=='A',
   "a later stable camera callback may acquire after the original raced lease retired");
 }

}
std::vector<camera_diagnostics::Evidence> camera_diagnostic_rows;
bool camera_diagnostic_sink(const camera_diagnostics::Evidence& row) noexcept {camera_diagnostic_rows.push_back(row);return true;}
void camera_diagnostic_lock_outcomes(){
 for(unsigned attempt=0;attempt<3;++attempt)for(unsigned change=0;change<4;++change){
  camera_publish_input=true;camera_override_input=false;camera_adapter_ready=true;camera_input={};
  camera_toggle(false);on_camera_tick(1,6,true,true);camera_toggle(true);on_camera_tick(1,6,true,true);
  check(camera_lease_requested,"camera diagnostic starts with actual source-composed lease");
  camera_publish_input=false;camera_diagnostic_rows.clear();
  std::atomic<bool> requested{},held{},attempted{};
  std::thread holder([&]{
   while(!requested.load())std::this_thread::yield();
   std::lock_guard lock(ollie_mutex);held=true;
   while(!attempted.load())std::this_thread::yield();
   if(change==1)camera_wait_clock=clock_ms+151;
   if(change==2){arcade_input.invalidate_authority();controller_route.clear();}
   if(change==3){mode_enabled=false;camera_reset_generation.fetch_add(1);}
  });
  const auto hold=[&]{requested=true;while(!held.load())std::this_thread::yield();ollie_mutex.attempted=&attempted;};
  if(attempt==0)camera_read_hook=hold;else if(attempt==1)camera_capture_hook=hold;else camera_apply_hook=hold;
  check(camera_diagnostics::capture.arm(clock_ms,500,0,camera_diagnostic_sink),"camera finite diagnostic armed");
  camera_diagnostics::capture.begin(camera_diagnostics::frame,clock_ms,0);
  on_camera_tick(1,6,true,true);
  camera_diagnostics::capture.finish(camera_diagnostics::frame,GetTickCount64()+1,0);
  holder.join();ollie_mutex.attempted=nullptr;
  check(camera_diagnostics::capture.arm(GetTickCount64()+2,0,0,camera_diagnostic_sink),"camera diagnostic stops");
  check(camera_diagnostic_rows.size()==3,"begin observed tick andend");
  const auto& row=camera_diagnostic_rows[1];
  check(row.input_count>=attempt+1&&row.input[attempt].inspected,"contention must inspect the snapshot after its publisher completes");
  if(!change){
   check(row.input_count==3&&row.input[attempt].valid&&!row.restore_requests&&camera_lease_requested,
    "unchanged fresh source under contention must not restore and reacquire the camera");
  }else{
   if(change==1)check(!row.input[attempt].valid,
    "camera snapshot freshness must include time waiting for its publisher");
   check(row.restore_requests&&row.restore_successes&&!camera_lease_requested,
    change==1?"camera snapshot freshness must include time waiting for its publisher":
    change==2?"real source withdrawal during contention must restore the camera":
    "OFF during contention must restore the camera before returning");
  }
  camera_wait_clock=0;if(change==2)controller_route.reset();if(change==3)camera_toggle(true);
  camera_publish_input=true;on_camera_tick(1,6,true,true);
  check(camera_lease_requested,"fresh enabled source can continue or reacquire after contention");
 }
 camera_toggle(false);on_camera_tick(1,6,true,true);controller_route.reset();
}
std::uint64_t qualified(bool nose,unsigned dt,unsigned duration){
 const auto wanted=nose?0x8000u:0x4000u;
 prepare_air(nose,dt);rows.push_back({40,50,nose?2u:1u});tick(dt,100,wanted);const auto delivered=remap();
 check(delivered.manual.owns&&delivered.manual.confirmed&&manual_balance_admitted.load(),"matching contact/history admits the original delivered preparation");
 const auto original=delivered.manual.request_at;
 while(clock_ms-original<duration){const auto state=snapshot();tick(dt,100,wanted);remap(0,state.velocity>0?25000:-25000);check(manual_balance_admitted.load()&&balance_hud_pending(),"qualified corrected balance continues independently of original request lifetime");}
 return original;
}
#if defined(DINGOSDK_MANUAL_LIFECYCLE_HUD)
void rendered(bool expected,const char* why,BalanceKind kind=BalanceKind::manual){
 check(balance_hud_pending()==expected,why);
 ImGui::NewFrame();draw_balance_hud();
 const auto& vertices=ImGui::GetBackgroundDrawList()->VtxBuffer;
 if(expected){
  const auto& display=combo_session.balance_display_state();
  check(display.balance_kind==kind,"native lifecycle selects the expected displayed balance family");
  const bool safe_side=kind==BalanceKind::manual && (physical_manual.nose()?display.balance>0:display.balance<0);
  const auto color=safe_side?IM_COL32(90,225,150,255):danger_level>=2?IM_COL32(255,65,65,255):danger_level==1?IM_COL32(255,190,65,255):IM_COL32(90,225,230,255);
  if(kind==BalanceKind::manual)check(meter.endpoints==(physical_manual.nose()?BalanceEndpoints::negative_bail:BalanceEndpoints::positive_bail)&&
      meter.limit==physical_manual.display_limit(),"actual HUD retains the governing physical type and terminal limit");
  float left=std::numeric_limits<float>::max(),top=left,right=std::numeric_limits<float>::lowest(),bottom=right;
  unsigned cursor{};const ImU32 rgb=~IM_COL32_A_MASK;
  for(int i=vertices.Size-1;i>=0&&(vertices[i].col&rgb)==(color&rgb);--i){
   if(!(vertices[i].col&IM_COL32_A_MASK))continue;
   ++cursor;left=std::min(left,vertices[i].pos.x);right=std::max(right,vertices[i].pos.x);
   top=std::min(top,vertices[i].pos.y);bottom=std::max(bottom,vertices[i].pos.y);
  }
  check(cursor>=3,"actual renderer distinguishes the governing safe-putdown side from danger");
  const auto screen=ImGui::GetIO().DisplaySize;const float balance=std::clamp(display.balance,-1.f,1.f);
  const float x=kind==BalanceKind::manual?screen.x*.8f:screen.x*(.5f+.15f*balance);
  const float y=kind==BalanceKind::manual?screen.y*(.5f-.15f*balance):screen.y*.78f;
  check(std::abs((left+right)/2-x)<.75f&&std::abs((top+bottom)/2-y)<.75f,
        "admitted physical position reaches the rendered cursor on the correct axis");
 }
 check(std::all_of(vertices.begin(),vertices.end(),[](const ImDrawVert& v){return std::isfinite(v.pos.x)&&std::isfinite(v.pos.y);}),
       "native lifecycle never submits nonfinite HUD geometry");
 ImGui::Render();check((ImGui::GetDrawData()->TotalVtxCount>0)==expected,why);
}
void original_hud_source(){
 check(observed.valid&&observed.sampled_at_ms==latest.sampled_at,
       "client publication retains the original native HUD timestamp");
}
void hud_lifecycle(){
 ImGui::CreateContext();auto& io=ImGui::GetIO();io.IniFilename=nullptr;io.LogFilename=nullptr;
 io.DisplaySize=ImVec2(1280,800);unsigned char* pixels{};int width{},height{};
 io.Fonts->GetTexDataAsRGBA32(&pixels,&width,&height);
 qualified(false,17,300);
 input_capture_correlation.schema4_enabled=true;
 capture_manual_join.request=99;capture_manual_join.model_seen=true;
 capture_manual_join.owner=latest.owner;capture_manual_join.owner_generation=latest.owner_generation;
 render_ack.store(diagnostic_draw_receipt,std::memory_order_release);
 diagnostic_client(.017f);
 const auto first_publication=observed.publication;
 check(first_publication&&capture_manual_join.publication_seen&&diagnostic_draws==0,
       "first actual model publication is tagged without claiming an ImGui draw");
 ++clock_ms;diagnostic_client(.017f);
 check(observed.capture==7&&observed.request==99&&observed.publication==first_publication&&
       diagnostic_draws==0,"client republication before render retains the first request/publication identity");
 rendered(true,"delayed first draw submits actual Manual geometry");
 check(diagnostic_draws==1&&diagnostic_draw_source.publication==first_publication&&
       diagnostic_draw_source.request==99,"delayed first draw acknowledges the original publication");
 ++clock_ms;diagnostic_client(.017f);
 check(!observed.capture&&balance_hud_pending()&&diagnostic_draws==1,
       "client publication after first acknowledged draw does not replay the diagnostic identity");
 render_ack.store(nullptr,std::memory_order_release);
 input_capture_correlation.schema4_enabled=false;capture_manual_join={};
 for(bool nose:{false,true})for(unsigned hz:{30u,60u}){
  hud_hz=hz;io.DeltaTime=1.f/hz;const unsigned dt=hz==30?34:17;
  const auto wanted=nose?0x8000u:0x4000u;
  prepare_air(nose,dt);rendered(false,"delivered airborne preparation alone renders no fabricated bar");
  tick(dt,100,wanted);remap();
  check(manual_balance_admitted.load(),"attributed airborne delivery and fresh matching landing contact admit before a name");
  rendered(true,"attributed first landing contact renders the admitted balance before history presentation");
  rows.push_back({40,50,nose?2u:1u});tick(dt,100,wanted);remap();
  check(manual_balance_admitted.load(),"independent matching contact/history admits the prepared physical section");
  original_hud_source();rendered(true,"new admitted Manual or Nose renders on its first client frame");
  for(unsigned frame=0;frame<hz;++frame){
   const auto state=snapshot();tick(dt,100,wanted);remap(0,state.velocity>0?25000:-25000);
   original_hud_source();rendered(true,"fresh original physics intervals sustain the admitted rendered balance");
  }
  // Repeated client callbacks consume the unchanged physics proof. Their own
  // clock cannot renew the producer timestamp or create new dynamics intervals.
  const auto source=latest.sampled_at;clock_ms=source+1;client(1.f/hz,history());
  original_hud_source();rendered(true,"duplicate client callback preserves admitted display and original evidence");
  clock_ms=source+150;client(1.f/hz,history());original_hud_source();
  rendered(true,"actual producer-to-render lease includes its original150ms endpoint");
  check(balance_hud_pending(),"current overlay scheduling observes the last fresh source frame");
  clock_ms=source+151;rendered(false,"source expiry between scheduling and actual draw submits no old geometry");
  client(1.f/hz,history());rendered(false,"client republication cannot revive expired native evidence");

  for(unsigned loss=0;loss<3;++loss){
   qualified(nose,dt,300);rendered(true,"negative control begins with an actually admitted rendered section");
   tick(dt,100,loss==2?wanted:0,loss!=2);remap();
   if(loss==1){tick(dt,100,wanted);remap();}
   rendered(false,"missing, discontinuous or invalid native contact clears the rendered section");
  }
  qualified(nose,dt,300);++owner.rig;tick(dt,100,wanted);remap();
  rendered(false,"changed native owner cannot transplant a rendered balance");

  qualified(nose,dt,300);const auto hop=remap(0x1000);
  check(hop.jump.setup_started,"admitted Manual hop starts through the existing input facade");
  tick(dt,103,0xc000);remap(0x1000);rendered(false,"observed hop crouch removes the old rendered balance");
  tick(dt,103,0xc000);remap();tick(dt,200,0);remap();
  rendered(false,"verified Manual-to-AIR transition renders no old balance");
  bool ended{};for(unsigned i=0;i<100;++i){tick(dt,200,0);if(!remap().authored_playback){ended=true;break;}}
  check(ended,"existing hop playback finishes before new return preparation");
  tick(dt,200,0);remap(nose?2u:1u);tick(dt,200,0);remap(nose?1u:2u);
  rendered(false,"new airborne return request alone still renders no balance");
  rows.push_back({60,50,nose?2u:1u});tick(dt,100,wanted);remap();
  check(manual_balance_admitted.load(),"fresh return history/contact admits its own physical section");
  original_hud_source();rendered(true,"qualified Manual return renders from fresh native evidence");
  tick(dt,200,0);remap();tick(dt,100,0xc000);remap();
  rendered(false,"ordinary observed landing does not restore the old Manual bar");

  qualified(nose,dt,300);set_enabled(false,false);
  check(!active&&!observed.valid,"actual OFF callback clears the HUD publication source immediately");
  rendered(false,"actual OFF callback removes submitted balance before another client callback");
  set_enabled(true,false);rendered(false,"actual re-enable cannot replay the old admitted display");
  for(unsigned i=0;i<3;++i){tick(dt,100,wanted);remap(nose?1u:2u);rendered(false,"held controls after re-enable cannot fabricate fresh balance ownership");}
  tick(dt,100,0xc000);remap();tick(dt,100,0xc000);remap(nose?2u:1u);
  tick(dt,100,0xc000);remap(nose?1u:2u);rows.push_back({80,50,nose?2u:1u});
  tick(dt,100,wanted);remap();check(manual_balance_admitted.load(),"fresh release and gesture can establish new post-enable balance");
  original_hud_source();rendered(true,"post-enable qualified section has a new rendered source");

  qualified(nose,dt,300);bool failed{};
  for(unsigned i=0;i<20*hz;++i){tick(dt,100,wanted);remap();if(combo_session.failed_section()){failed=true;break;}}
  check(failed,"unchanged physical balance dynamics supplies an actual endpoint failure in the fixture");
  check(!manual_balance_admitted.load()&&danger_level==2,"failed physical section withdraws admission and publishes the existing danger display");
  rendered(true,"failed section keeps its existing red edge while native bail is pending");
  tick(dt,300,0);remap();rendered(false,"positive native bail clears the retained failed display");

  qualified(nose,dt,300);tick(dt,401,0);remap();
  rendered(true,"distinct observed rail family selects its horizontal display",BalanceKind::grind);
  tick(dt,200,0);remap();rendered(false,"native rail-to-air exit clears the horizontal display");
 }
 hud_hz=0;ImGui::DestroyContext();
}
#endif
void controller_packet_dependencies(){
 reset_case();
 controller_route.observe(1,{true,clock_ms,0,0,0,0,0,0,0});controller_route.select(clock_ms,2,true);
 const auto generation=controller_route.generation();
 check(controller_route.accepts(1,clock_ms),"real controller adapter is selected before exact mode reset");
 check(playback_packets[1].sample(20,20,true)==21&&playback_packets[1].sample(20,20,true)==22,
       "real physical-source packet class establishes owned output before mode reset");
 check(playback_packets[2].sample(30,30,true)==31&&playback_packets[2].sample(30,30,true)==32,
       "separate historical source retains its own packet identity");
 set_enabled(false,false);
 check(!controller_route.accepts(1,clock_ms)&&controller_route.generation()!=generation,
       "exact production mode reset revokes the real selected controller generation");
 check(playback_packets[1].sample(22,22,false)==23&&playback_packets[1].sample(22,22,false)==22,
       "extracted real packet retirement preserves one visible cancellation after OFF");
 check(playback_packets[0].sample(22,22,false)==22,"mode reset does not invent packet debt for an untouched source");
 set_enabled(true,false);
 check(playback_packets[2].sample(500,500,true)==501,
       "extracted retirement helper starts recovery from the current physical baseline");
}
void air_admission_lifecycle(){
 for(bool nose:{false,true})for(unsigned dt:{17u,34u}){
  prepare_air(nose,dt);const auto origin=remap().manual.recognized_at;
  tick(dt,100,0xc000u);const auto ground=remap().manual;
  check(ground.from_air&&ground.recognized_at==origin&&ground.request_at==clock_ms,
        "first grounded delivery retains air recognition while beginning a distinct acquisition clock");
  while(clock_ms<ground.request_at+800){tick(dt,100,0xc000u);remap();}
  tick(dt,100,nose?0x8000u:0x4000u);remap();
  check(clock_ms>origin+700&&manual_balance_admitted.load()&&!manual_release.pending(),
        "observed two-wheel delivery transfers to the existing ground acquisition path without a renewed air deadline");
 }
 for(bool nose:{false,true})for(unsigned dt:{17u,34u}){
  prepare_air(nose,dt);corrupt_manual_delivery=true;tick(dt,200,0);
  const auto dropped=remap();check(dropped.manual.owns&&dropped.right_y==0,
      "delivery corruption control preserves the semantic request while withholding its actual native pad");
  corrupt_manual_delivery=false;tick(dt,100,nose?0x8000u:0x4000u);remap();
  check(!manual_balance_admitted.load()&&!balance_hud_pending(),
      "semantic ownership without actual partialRS delivery cannot admit first landing balance");
 }
 for(bool nose:{false,true})for(unsigned dt:{17u,34u})for(bool qualified:{false,true}){
  prepare_air(nose,dt);const auto wanted=nose?0x8000u:0x4000u;
  const auto original=remap().manual;
  check(original.from_air&&original.recognized_at&&original.recognized_at==original.request_at,
        "actual airborne delivery exports its immutable recognized request separately from landing acquisition time");
  if(!qualified){clock_ms+=dt;observe(dt/1000.f,0,200,true,false);client(dt/1000.f,history());remap();}
  tick(dt,100,wanted);const auto landed=clock_ms;remap();
  check(manual_balance_admitted.load()==qualified&&balance_hud_pending()==qualified,
        "only an attributed unchanged airborne request admits balance at its first matching native landing");
  const auto first=snapshot();
  for(unsigned age=0;age<1300;age+=dt){
   if(age>=300&&rows.empty())rows.push_back({40,50,nose?2u:1u});
   const auto previous=snapshot();tick(dt,100,wanted);const auto out=remap(0,previous.velocity>0?25000:-25000);
   if(qualified)check(manual_balance_admitted.load()&&!manual_release.pending()&&out.manual.owns&&snapshot().elapsed>previous.elapsed,
       "source-qualified airborne balance continues beyond acquisition cleanup and late history never restarts dynamics");
   if(!qualified&&age<300)check(!manual_balance_admitted.load()&&!balance_hud_pending(),
       "unknown native selection still requires independent matching history despite delivered stick and physical contact");
  }
  check(qualified?first.elapsed>0:!first.active,
        "initial balance is tied to the qualified original landing interval and never backdated from later presentation");
  check(clock_ms>landed+1200&&manual_balance_admitted.load(),
        "a later independent history edge can still admit the unchanged fallback without changing its native contract");
 }
 for(bool nose:{false,true})for(unsigned dt:{17u,34u}){
  prepare_air(nose,dt);clock_ms+=dt;observe(dt/1000.f,0,200,true,false);client(dt/1000.f,history());remap();
  const auto wanted=nose?0x8000u:0x4000u;tick(dt,100,wanted);remap();const auto landed=clock_ms;
  while(clock_ms<landed+1200+dt){tick(dt,100,wanted);remap();}
  check(!manual_balance_admitted.load()&&!balance_hud_pending()&&!manual_release.pending(),
        "absent attributable air delivery cannot invent admission or synthetic putdown");
 }
}
std::uint64_t start_analog_air(unsigned dt){
 reset_case();observe(dt/1000.f,0xc000);client(dt/1000.f,history());remap();
 tick(dt,100,0xc000);const auto press=remap(0x1000);check(press.jump.setup_started,"analog trial begins with admitted physical A setup");
 for(unsigned i=0;i<3;++i){tick(dt,103,0xc000);remap(0x1000);}
 tick(dt,103,0xc000);const auto release=remap();check(release.jump.released&&release.jump.setup_admitted,"one A release precedes the analog airborne gesture");
 tick(dt,200,0);remap();arcade_input.set_recognition_capture(0,true);
 const auto policy=arcade_input.input_diagnostic(0)->policy;
 check(policy.normalization==InputNormalization::analog&&policy.manual_sample_allowance==55&&policy.inclusive_manual&&policy.reject_opposing,
       "actual production constructor and remap retain ground sampling allowance and physical safety; air remains strict");
 return clock_ms;
}
void analog_air_boundaries(){
 for(bool nose:{false,true})for(unsigned dt:{17u,34u})for(unsigned gap:{399u,400u})for(unsigned age:{699u,700u,701u}){
  start_analog_air(dt);const short first=nose?-13057:12800,second=nose?12800:-13057;
  tick(dt,200,0);remap(0,first);const auto first_at=clock_ms;
  while(clock_ms<first_at+gap){const auto step=static_cast<unsigned>(std::min<std::uint64_t>(dt,first_at+gap-clock_ms));tick(step,200,0);remap(0,first);}
  const auto recognized=clock_ms;const auto out=remap(0,second);
  check(out.manual.owns==(gap<400),"actual analog399ms pairing starts the existing adapter while400ms equality is rejected");
  while(clock_ms+dt<recognized+age){tick(dt,200,0);remap();}
  tick(static_cast<unsigned>(recognized+age-clock_ms),100,nose?0x8000u:0x4000u);const auto landed=remap();
  check(manual_balance_admitted.load()==(gap<400&&age<=700)&&balance_hud_pending()==(gap<400&&age<=700),
        "actual analog AIR recognition700ms landing is eligible and701ms cannot revive expired intent");
  if(gap<400&&age<=700)check(landed.manual.owns&&landed.manual.recognized_at==recognized,
        "landing acquisition time never replaces the original analog recognition deadline");
 }
}
void analog_air_lifecycle(){
 for(bool nose:{false,true})for(unsigned dt:{17u,34u})for(unsigned phase=0;phase<dt;++phase)
 for(unsigned shape=0;shape<5;++shape)for(bool release_final:{false,true}){
  const auto air_at=start_analog_air(dt);const auto first_at=air_at+dt+phase,second_at=air_at+140+phase;
  const short first=nose?-13057:12800,second=nose?12800:-13057,below=nose?-13056:12799;
  std::uint64_t recognized{},first_edge{},last_edge{},delivered{};unsigned recognized_count{};
  while(clock_ms<air_at+450){
   const auto next=clock_ms+dt;short y=below,x=0;
   if(next>=first_at&&next<second_at){
    y=shape==4?below:first;
    if(shape==1&&next>=first_at+dt)y=0;
    if(shape==2&&next>=first_at+dt){x=nose?-12800:13057;if(next>=second_at-dt)x=y=0;}
    if(shape==3)x=nose?-12800:13057;
   }else if(next>=second_at){y=release_final&&next>=second_at+2*dt?0:second;if(shape==3&&y)x=nose?13057:-12800;}
   tick(dt,200,0);const auto out=remap(0,y,x);
   const auto* diagnostic=arcade_input.input_diagnostic(0);
   for(std::size_t i=0;i<diagnostic->recognition_count;++i){const auto& request=diagnostic->recognition[i].request;
    if(request.action!=InputAction::manual&&request.action!=InputAction::nose_manual)continue;
    ++recognized_count;recognized=request.recognized_at;first_edge=request.first_input_at;last_edge=request.last_input_at;
    check(request.context==InputContext::air&&request.action==(nose?InputAction::nose_manual:InputAction::manual)&&
          recognized==clock_ms&&recognized-first_edge<400&&last_edge==recognized,
          "analog cardinal edges keep their observed strict400ms pair clock and typed once-only recognition");
   }
   if(out.manual.owns){if(!delivered)delivered=clock_ms;check(out.manual.from_air&&out.manual.recognized_at==recognized&&
       out.right_x==0&&out.right_y==(nose?20000:-20000),"actual prelanding RS delivery retains the immutable analog recognition and family");}
   check(!manual_balance_admitted.load()&&!balance_hud_pending(),"analog airborne request and pad output alone cannot fabricate grounded balance");
  }
  const bool valid=shape<3;
  check(recognized_count==(valid?1u:0u)&&bool(delivered)==valid,
        "raw native analog trajectories recognize once; pure diagonals and insufficient first throw cannot substitute cardinal edges");
  if(valid){
   unsigned consumed{};for(const auto& event:arcade_input.history(0)->events())if(event.token.source==InputSource::direction&&
       event.token.edge==InputEdge::press&&(event.at==first_edge||event.at==last_edge)){
       check(event.owners==InputConsumption::manual,"only the matched analog presses commit the Manual consumption category");++consumed;}
   check(consumed==2,"one analog pair consumes its two actual logical press edges");
  }
  tick(dt,100,nose?0x8000u:0x4000u);const auto landed=remap(0,release_final?0:second);
  check(manual_balance_admitted.load()==valid&&balance_hud_pending()==valid,
        "same-owner matching landing starts actual model/HUD only after a qualified analog AIR receipt");
  if(valid)check(landed.manual.owns&&landed.manual.confirmed&&rows.empty()&&snapshot().elapsed>0,
       "held-final and released-final analog gestures both enter without a second face press or synthetic history label");
 }
}


void analog_manual_entry_tolerance(){
 for(bool air:{false,true})for(bool nose:{false,true})for(unsigned hz:{30u,60u,120u})
 for(short horizontal:{short{0},short{14000},short{-18000},short{26000},short{31000}}){
  const unsigned dt=1000/hz;
  if(air)start_analog_air(dt);
  else {reset_case();observe(dt/1000.f,0xc000);client(dt/1000.f,history());remap();}
  arcade_input.set_recognition_capture(0,true);
  const unsigned state=air?200:100,contacts=air?0:0xc000;
  const short first=nose?-28000:28000,second=static_cast<short>(-first);
  tick(dt,state,contacts);const auto first_out=remap(0,first,horizontal);
  const auto first_at=clock_ms;
  const bool accepted=horizontal!=31000;
  if(!air&&nose)check(first_out.suppress_reverse==accepted,
      "vertical-dominant first Down reserves native reverse during manual recognition; steering-dominant input does not");
  for(unsigned i=0;i<140/dt;++i){tick(dt,state,contacts);remap(0,first,i%2?horizontal:0);}
  tick(dt,state,contacts);const auto output=remap(0,second,horizontal);
  if(output.manual.owns!=accepted)std::cerr<<"entry air="<<air<<" nose="<<nose<<" hz="<<hz<<" x="<<horizontal<<" request="<<output.manual.request<<" safe="<<output.manual.safe<<"\n";
  check(output.manual.owns==accepted,
      "production manual entry accepts vertical-dominant diagonal pairs at30/60/120Hz and rejects steering-dominant pairs");
  if(accepted){
   check(output.manual.request==(nose?1:-1)&&output.right_y==(nose?20000:-20000),
       "tolerant manual gesture retains native RS direction and pressure");
   const auto* diagnostic=arcade_input.input_diagnostic(0);
   unsigned matches{};
   for(std::size_t i=0;i<diagnostic->recognition_count;++i){const auto& request=diagnostic->recognition[i].request;
    if(request.action==InputAction::manual||request.action==InputAction::nose_manual){
     if(request.first_input_at!=first_at||request.last_input_at!=clock_ms)std::cerr<<"edge air="<<air<<" nose="<<nose<<" hz="<<hz<<" x="<<horizontal<<" first="<<first_at<<" actual="<<request.first_input_at<<" last="<<request.last_input_at<<" now="<<clock_ms<<"\n";
     ++matches;check(request.first_input_at==first_at&&request.last_input_at==clock_ms,
         "manual tolerance consumes real shared direction edges without fabricated edge times");
    }
   }
   check(matches==1,"one physical vertical pair creates one manual request");
   tick(dt,100,nose?0x8000u:0x4000u);remap(0,second,horizontal);
   check(manual_balance_admitted.load()&&balance_hud_pending(),
       "tolerant ground and air requests still require original native contact before model and HUD admission");
  }
 }
}
void manual_handoff_native_boundaries(){
 for(bool nose:{false,true})for(unsigned hz:{30u,60u,120u})for(unsigned missing=0;missing<9;++missing){
  const unsigned dt=1000/hz;raw.words[0]=0;qualified(nose,dt,300);
  const auto id=manual_episode.serial();const auto began=clock_ms;
  check(remap(0,0,0,255).action.owned,"native handoff negative control begins from independently admitted manual and RT");
  while(clock_ms-began<300){
   tick(dt,missing==0?100:101,0xc000);remap();
  }
  // A label may exist even when the physical transition is incomplete. It
  // cannot stand in for the missing state, owner or original interval.
  ScoreLabelOccurrence event{true,score_label_bit(3),1,clock_ms,clock_ms,ScoreLabelUncertainty::none};
  client(dt/1000.f,history(),event);
  if(missing==8){
   raw.state=100;raw.words[0]^=0x20u;client(dt/1000.f,history());
   const auto retained=remap();
   check(!retained.manual.owns || retained.manual.request==(nose?1:-1),"client-ahead stance publication cannot substitute for a new original native transition step");
   check(manual_episode.serial()==id,"client-only publication retains original episode identity");continue;
  }
  if(missing==2){tick(dt,103,0xc000);remap();}
  if(missing==3){owner.rig+=16;}
  raw.words[0]^=0x20u;
  if(missing==1)raw.words[0]|=0x40u;
  const unsigned state=missing==4?300:missing==5?504:missing==6?400:100;
  tick(missing==7?200:dt,state,nose?0x4000u:0x8000u);
  const auto refused=remap();
  check((!refused.manual.owns || refused.manual.request==(nose?1:-1))&&!refused.manual.revert.ack_at,
      "physical handoff rejects absent101, pushing owner, interrupted transition, owner loss, bail, offboard, grind and an original-step gap even with a score label");
  check(manual_episode.serial()==id,"failed native handoff never creates a replacement manual episode");
 }
}
void manual_revert_production(){
 for(bool nose:{false,true})for(unsigned hz:{30u,60u,120u})for(bool ack:{false,true})for(unsigned contact_mode:{0u,1u,2u})for(unsigned ack_delay:{300u,900u})for(bool rapid:{false,true}){
  if(rapid&&(ack||contact_mode!=2||ack_delay!=900))continue;
  const unsigned dt=1000/hz;const bool already=contact_mode==1;
  qualified(nose,dt,300);const bool initial_nose=nose;trial_hz=hz;trial_start=clock_ms;trial_frame=0;
  const auto episode_id=manual_episode.serial();
  const auto multiplier=combo_session.model().state().multiplier;
  for(unsigned link=0;link<2u;++link){
   const auto began=clock_ms;
   const auto started=remap(0,0,0,255);
   check(started.action.owned,"qualified production manual admits one discrete RT actor");
   RevertPlayback reference;
   check(reference.start(began,RevertSide::frontside,{nose,!(raw.words[0]&0x20u),false,static_cast<short>(nose?20000:-20000)},true),"reference uses the unchanged native revert recipe");
   const auto verify_left=[&](const NativeGesture::Output& actual){
    const auto expected=reference.sample(clock_ms,true);
    if(actual.action.pad.owns_left_stick!=expected.owns_sticks || (expected.owns_sticks&&(actual.action.pad.left_x!=expected.left_x||actual.action.pad.left_y!=expected.left_y)))
     std::cerr<<"revert waypoint nose="<<nose<<" hz="<<hz<<" ack_delay="<<ack_delay<<" age="<<clock_ms-began<<" owns="<<actual.action.pad.owns_left_stick<<" expected="<<expected.owns_sticks<<" manual="<<actual.manual.owns<<"\n";
    check(actual.action.pad.owns_left_stick==expected.owns_sticks&&
       (!expected.owns_sticks||(actual.action.pad.left_x==expected.left_x&&actual.action.pad.left_y==expected.left_y)),
       "manual successor preserves every native LS revert waypoint and its original clock");
   };
   verify_left(started);
   while(clock_ms-began<ack_delay){
    advance_trial(dt);observe(dt/1000.f,0xc000,101);client(dt/1000.f,history());verify_left(remap(0,0,0,255));
    check(combo_session.model().state().combo_active&&!combo_session.model().state().revert_pending,
       "admitted native revert preparation preserves original combo beyond landing grace without claiming success");
   }
   if(ack){
    ScoreLabelOccurrence event{true,score_label_bit(3),link+1,clock_ms,clock_ms,ScoreLabelUncertainty::none};
    client(dt/1000.f,history(),event);
   }
   check(combo_session.model().state().revert_pending==ack,"physical handoff cannot fabricate a missing native score-label acknowledgment");
   const auto retained=remap(0,0,0,255);
   check(!retained.manual.owns || retained.manual.request==(nose?1:-1),"neither a score label nor native101 alone transfers RS before original grounded return");
   // Live Deck trace: foot-leading0x20 stays unchanged through native101->100.
   // Native return can retain the old one-wheel contact until successor RS arrives.
   advance_trial(dt);observe(dt/1000.f,already?(nose?0x4000u:0x8000u):contact_mode==2?(nose?0x8000u:0x4000u):0xc000u);client(dt/1000.f,history());
   const auto out=remap(already&&ack_delay==900?0x6000u:0u,0,0,255);
   check(out.manual.owns&&out.manual.request==(nose?-1:1),"observed native return with unchanged foot stance transfers manual RS before the native LS revert finishes");
   verify_left(out);
   check(!out.action.pad.owns_right_stick&&out.right_y==(nose?20000:-20000),"successor takes RS at original pressure without a native flick while RT remains held");
   // Client publication can run again before either XInput or the next
   // original physics callback. It must not erase the delivered acquisition.
   client(dt/1000.f,history());
   remap(0,0,0,255);client(dt/1000.f,history());remap(0,0,0,255);
   const auto pressure_began=clock_ms;short previous=out.right_y;
   while(clock_ms-pressure_began<200){
    const auto duplicate=remap(0,0,0,255);
    check(duplicate.right_y==previous,"duplicate client/input polls cannot advance the native-step pressure trajectory");
    advance_trial(dt);observe(dt/1000.f,already?(nose?0x4000u:0x8000u):0xc000u);client(dt/1000.f,history());
    const auto crossing=remap(0,0,0,255);verify_left(crossing);
    const int delta=(nose?-1:1)*(crossing.right_y-previous);
    check(crossing.manual.owns&&!crossing.action.pad.owns_right_stick&&delta>=0&&delta<=static_cast<int>(((1000+hz-1)/hz)*200),
        "native-step transfer owns RS and crosses monotonically without an instantaneous opposite flick");
    check(manual_episode.serial()==episode_id&&balance_hud_pending()&&combo_session.model().state().combo_active,
        "measured two-truck pressure crossing preserves original episode and HUD without a false physical exit");
    previous=crossing.right_y;
   }
   check(previous==(nose?-20000:20000),"200ms of consecutive native observations completes successor pressure");
   nose=!nose;advance_trial(dt);observe(dt/1000.f,nose?0x8000u:0x4000u);client(dt/1000.f,history());verify_left(remap(0,0,0,255));
   check(manual_episode.pose()==(nose?SkatePose::nose_manual:SkatePose::manual)&&manual_balance_admitted.load()&&balance_hud_pending()&&combo_session.model().state().combo_active,
      "delivered successor owns opposite balance and HUD on the next original step while native LS may still run");
   if(rapid&&link==0){
    remap(); // Real RT release then press before the next original physics step.
    continue;
   }
   const auto acquired=clock_ms;
   while(clock_ms-acquired<10000){const auto state=snapshot();tick(dt,100,nose?0x8000u:0x4000u);const auto held=remap(0,state.velocity+.02f*state.position>0?-25000:25000,0,clock_ms-began<1200?255:0);
    if(clock_ms-began<1200)verify_left(held);
    check(held.manual.owns&&held.right_y==(nose?20000:-20000)&&!held.action.pad.owns_right_stick,"opposite RS ownership remains continuous across native revert completion and held RT release");
    if(!(manual_balance_admitted.load()&&balance_hud_pending()&&combo_session.model().state().combo_active))
     std::cerr<<"linked failure nose="<<nose<<" dt="<<dt<<" already="<<already<<" age="<<clock_ms-acquired<<" balance="<<manual_balance_admitted.load()<<" hud="<<balance_hud_pending()<<" combo="<<combo_session.model().state().combo_active<<" putdown="<<manual_release.pending()<<" position="<<state.position<<" velocity="<<state.velocity<<" elapsed="<<state.elapsed<<"\n";
    check(manual_episode.serial()==episode_id&&combo_session.model().state().multiplier==multiplier&&manual_balance_admitted.load()&&balance_hud_pending()&&combo_session.model().state().combo_active,
       "revert-linked balance survives the acquisition deadline without artificial putdown");}
  }
  trial_hz=0;
  std::cout<<"PASS label="<<ack<<" "<<(initial_nose?"Nose->Manual->Nose":"Manual->Nose->Manual")<<(rapid?" immediate chain and 10s hold ":" two 10s holds ")<<hz<<"Hz contact_mode="<<contact_mode<<"\n";
 }
}
void manual_revert_contact_publication_gap(){
 for(bool nose:{false,true})for(unsigned hz:{30u,60u,120u}){
  const unsigned dt=1000/hz;qualified(nose,dt,300);
  const auto id=manual_episode.serial(),request_at=remap().manual.request_at;
  // Live c45 chain: original contact changes to both trucks before the next
  // client publication, in the same interval as the second physical RT edge.
  clock_ms+=dt;observe(dt/1000.f,0xc000u);
  const auto waiting=remap(0,0,0,255);
  if(!waiting.manual.owns)std::cerr<<"gap nose="<<nose<<" hz="<<hz<<" safe="<<waiting.manual.safe<<" request="<<waiting.manual.request<<" output="<<waiting.right_y<<" action="<<waiting.action.owned<<" admitted="<<manual_balance_admitted.load()<<" observed="<<static_cast<unsigned>(manual_observed.load())<<" episode="<<static_cast<unsigned>(manual_episode.phase())<<"\n";
  check(waiting.manual.owns&&waiting.manual.request==(nose?1:-1)&&waiting.right_y==(nose?20000:-20000)&&waiting.manual.request_at==request_at,
      "RT during a contact-publication gap retains established manual RS instead of falling through to a ground revert");
  check(!waiting.action.owned&&!waiting.manual.revert.ack_at,
      "missing current balance correlation waits without fabricating revert admission or acknowledgment");
  client(dt/1000.f,history());const auto admitted=remap(0,0,0,255);
  check(admitted.action.owned&&admitted.manual.owns&&admitted.right_y==(nose?20000:-20000)&&!admitted.action.pad.owns_right_stick,
      "fresh authoritative episode publication admits the pending RT while preserving original RS");
  check(manual_episode.serial()==id&&balance_hud_pending()&&combo_session.model().state().combo_active,
      "contact-publication race cannot bank or replace the established manual episode");
  tick(dt,101,0xc000u);const auto turning=remap();
  check(turning.manual.owns&&turning.right_y==(nose?20000:-20000)&&manual_episode.transitioning(),
      "new native revert is linked to the retained manual rather than ordinary riding");
  const auto began=clock_ms;
  while(clock_ms-began<300){tick(dt,101,0xc000u);remap();}
  tick(dt,100,0xc000u);const auto transfer=remap();
  check(transfer.manual.revert.ack_at&&transfer.right_y==(nose?20000:-20000),
      "publication-gap recovery still requires native return before starting opposite pressure");
  const auto crossing=clock_ms;
  while(clock_ms-crossing<220){tick(dt,100,0xc000u);remap();}
  tick(dt,100,nose?0x4000u:0x8000u);remap();
  const auto acquired=clock_ms;
  while(clock_ms-acquired<10000){
   const auto balance=snapshot();tick(dt,100,nose?0x4000u:0x8000u);
   const auto held=remap(0,balance.velocity+.02f*balance.position>0?-25000:25000);
   check(held.manual.owns&&held.right_y==(nose?-20000:20000)&&manual_episode.serial()==id&&
       balance_hud_pending()&&combo_session.model().state().combo_active&&!manual_release.pending(),
       "contact-publication RT race recovers into ten seconds of opposite balance in the same episode");
  }
 }
 for(bool nose:{false,true})for(unsigned loss:{0u,1u,2u,3u,4u}){
  constexpr unsigned dt=17;qualified(nose,dt,300);
  clock_ms+=dt;observe(dt/1000.f,0xc000u);remap(0,0,0,255);
  if(loss==0)++owner.rig;
  if(loss==4){clock_ms+=200;}
  else {tick(loss==3?120:dt,loss==1?504:loss==2?300:100,0xc000u);}
  const auto refused=remap(0,0,0,255);
  check(!refused.manual.owns&&!refused.action.owned,
      "queued RT across owner loss, offboard, bail, real putdown or stale evidence cannot retain or recreate authority");
 }
}
void manual_revert_without_native_transition(){
 for(bool nose:{false,true})for(unsigned hz:{30u,60u,120u}){
  const unsigned dt=1000/hz;const auto wanted=nose?0x8000u:0x4000u;
  qualified(nose,dt,300);
  const auto episode=manual_episode.serial(),began=clock_ms;
  const auto request_at=remap().manual.request_at;
  check(remap(0,0,0,255).action.owned,"failed-revert regression starts the existing RT recipe from real admitted manual");
  while(clock_ms-began<10000){
   // Recorded inverse failure: native100 and the original nose contact,
   // without101 or any opposite contact. Finishing LS must not release RS.
   const auto feedback=snapshot();
   const auto age=clock_ms-began;
   tick(dt,100,age>=50&&age<215?0xc000u:wanted);
   const auto out=remap(0,feedback.velocity+.02f*feedback.position>0?-25000:25000,0,clock_ms-began<1200?255:0);
   check(out.manual.owns&&out.manual.request==(nose?1:-1)&&out.manual.request_at==request_at&&
       out.right_y==(nose?20000:-20000)&&!out.manual.revert.ack_at,
       "unacknowledged RT retains original manual actuator and request clock without a false opposite handoff");
   check(manual_episode.serial()==episode&&manual_balance_admitted.load()&&balance_hud_pending()&&combo_session.model().state().combo_active,
       "finite revert recipe cannot end an independently continuing original manual or combo");
  }
  tick(dt,100,0xc000);remap();
  for(unsigned i=0;i<200/dt+1;++i){tick(dt,100,0xc000);remap();}
  check(!remap().manual.owns&&!balance_hud_pending(),"retained original still exits on a verified native putdown");
 }
}
void manual_pressure_observation_gaps(){
 for(bool nose:{false,true})for(unsigned hz:{30u,60u,120u})for(bool owner_loss:{false,true}){
  const unsigned dt=1000/hz;const auto wanted=nose?0x8000u:0x4000u;
  qualified(nose,dt,300);const auto episode=manual_episode.serial();
  check(remap(0,0,0,255).action.owned,"pressure-gap case starts the real manual revert actor");
  for(unsigned i=0;i<5;++i){tick(dt,101,wanted);remap();}
  tick(dt,100,wanted);const auto start=remap();
  check(start.manual.revert.ack_at&&start.right_y==(nose?20000:-20000),"acknowledged transfer begins at actual original pressure");
  tick(dt,100,wanted);const auto first=remap();
  check(first.right_y!=start.right_y,"one new original step advances pressure");
  for(unsigned i=0;i<3;++i)tick(dt,100,wanted); // no consumer/delivery
  const auto resumed=remap();
  check(resumed.right_y==first.right_y&&resumed.manual.request_at==first.manual.request_at,
      "missed delivery steps do not jump pressure or restart acquisition");
  for(unsigned i=0;i<5;++i)check(remap().right_y==resumed.right_y,"repeated reads of one native sample leave pressure fixed");
  tick(dt,100,wanted);const auto next=remap();
  check((nose?-1:1)*(next.right_y-resumed.right_y)==static_cast<int>(dt*200),
      "resumed pressure advances only the next consecutive native interval");
  if(owner_loss)owner.rig+=16;else clock_ms+=1200;
  tick(dt,100,wanted);
  const auto lost=remap();
  check(!lost.manual.owns&&!manual_release.pending()&&manual_episode.serial()==episode&&(!owner_loss||!balance_hud_pending()),
      "owner loss or expired unfinished transfer revokes actuation without a pressure snap or synthetic putdown");
 }
}
void manual_observation_continuity(){
 for(bool nose:{false,true})for(unsigned dt:{8u,17u,34u}){
  const auto wanted=nose?0x8000u:0x4000u;qualified(nose,dt,300);
  const auto start=clock_ms;
  for(unsigned i=0;clock_ms-start<10000;++i){
   // The real producer advances independently of the client. One missing
   // dynamics row still has a native observer frame with unchanged identity.
   clock_ms+=dt;
   if(i==30){latest=native_input_state.observe(clock_ms,input_owner(owner),raw,{true,-1});}
   else observe(dt/1000.f,wanted);
   if(i>=50 && i<50+200/dt)continue; // queued original physics rows, no invented dt
   client(dt/1000.f,history());
   const auto before=snapshot().elapsed;
   client(dt/1000.f,history());
   check(snapshot().elapsed==before,"duplicate client polls never reintegrate manual time");
   if(!(manual_balance_admitted.load()&&balance_hud_pending()&&combo_session.model().state().combo_active))std::cerr<<"continuity nose="<<nose<<" dt="<<dt<<" i="<<i<<" age="<<clock_ms-start<<" active="<<physical_manual.active()<<" failed="<<combo_session.failed_section()<<" putdown="<<combo_session.manual_putdown()<<"\n";
   check(manual_balance_admitted.load()&&balance_hud_pending()&&combo_session.model().state().combo_active,
      "production manual survives missing row and delayed client without reset or HUD loss");
   // Ordinary signed correction through the real facade, not direct model writes.
   const auto feedback=snapshot();
   remap(0,(feedback.velocity+.02f*feedback.position)>0?-25000:25000);
  }
  tick(dt,100,0xc000);remap();
  for(unsigned i=0;i<200/dt+1;++i){tick(dt,100,0xc000);remap();}
  check(!manual_balance_admitted.load()&&!balance_hud_pending(),"real completed contact exit still ends retained manual");
 }
}
void episode_ground_gap_regression(){
 for(bool nose:{false,true}){
  provisional_ground(nose,false);
  check(balance_hud_pending(),"ground entry first publishes native admitted HUD");
  const auto before=snapshot();
  physical_manual_steps.invalidate(); // native frame still valid; missing dynamics record only
  client(.034f,history());
  check(balance_hud_pending() && manual_balance_admitted.load() && combo_session.model().state().combo_active,
        "P0: a missing dynamics record must not erase established grounded manual identity or HUD");
  check(snapshot().elapsed==before.elapsed && !manual_release.pending(),
        "P0: a missing dynamics record must neither integrate time nor request putdown");
 }
}

void episode_ten_seconds(){
 for(unsigned hz:{30u,60u,120u})for(bool nose:{false,true})for(bool early:{false,true}){
  reset_case();native_score_active=false;
  const unsigned dt=1000/hz;const auto wanted=nose?0x8000u:0x4000u;
  observe(1.f/hz,0xc000);client(1.f/hz,history());remap();
  tick(dt,100,0xc000);remap(nose?2u:1u);
  tick(dt,100,0xc000);check(remap(nose?1u:2u).manual.owns,"ground gesture delivers owned manual pressure");
  if(early){rows.push_back({900,901,nose?2u:1u});client(1.f/hz,history());}
  tick(dt,100,wanted);remap();
  check(balance_hud_pending(),"ground contact admits meter before late history");
  const auto id=manual_episode.serial();const auto multiplier=combo_session.model().state().multiplier;
  const auto started=clock_ms;
  for(unsigned i=1;i<=10*hz;++i){
   clock_ms=started+static_cast<std::uint64_t>(i)*1000/hz;
   if(i==4&&!early)rows.push_back({900,901,nose?2u:1u});
   // One transient two-truck frame, missing dynamics and history publication.
   observe(1.f/hz,i==hz?0xc000u:wanted);
   if(i==2*hz)physical_manual_steps.invalidate();
   client(1.f/hz,i==3*hz?ScoreLabelOccurrence{}:history());
   const auto before=snapshot().elapsed;client(1.f/hz,history());
   check(snapshot().elapsed==before,"duplicate client publication never invents physics time");
   const auto state=snapshot();const auto out=remap(0,state.velocity+.02f*state.position>0?-25000:25000);
   check(manual_episode.serial()==id&&manual_balance_admitted.load()&&balance_hud_pending()&&out.manual.owns&&
       !manual_release.pending()&&combo_session.model().state().combo_active&&combo_session.model().state().multiplier==multiplier,
       "10s ground episode retains identity, actuator, HUD and combo across realistic short gaps");
#if defined(DINGOSDK_MANUAL_LIFECYCLE_HUD)
   rendered(true,"grounded episode meter stays rendered");
#endif
  }
  std::cout<<"PASS ground "<<(nose?"Nose Manual":"Manual")<<" 10s "<<hz<<"Hz history="<<(early?"early":"late")<<"\n";
 }
}
void episode_real_exits(){
 for(unsigned hz:{30u,60u,120u})for(bool nose:{false,true}){
  const unsigned dt=1000/hz;const auto wanted=nose?0x8000u:0x4000u;
  for(unsigned boundary:{300u,401u,504u,701u,102u}){
   qualified(nose,dt,300);clock_ms+=dt;observe(1.f/hz,0,boundary);
   clock_ms+=dt;observe(1.f/hz,wanted);client(1.f/hz,history());const auto out=remap();
   check(manual_episode.ended()&&!out.manual.owns&&!manual_release.pending(),
       "positive native exit between clients retires episode and actuator without synthetic putdown");
  }
  qualified(nose,dt,300);
  for(unsigned i=0;i<hz/4;++i){tick(dt,100,0xc000);remap();}
  check(manual_episode.ended()&&!balance_hud_pending()&&!remap().manual.owns,
      "consecutive original two-truck samples confirm actual physical putdown");
  qualified(nose,dt,300);++owner.rig;tick(dt,100,wanted);
  check(!remap().manual.owns&&!balance_hud_pending(),"changed native owner cannot inherit stale manual authority");
  qualified(nose,dt,300);set_enabled(false,false);
  check(!balance_hud_pending()&&!remap().manual.owns,"Arcade OFF immediately retires HUD and actuator");
  for(bool safe:{false,true}){
   qualified(nose,dt,300);ManualBalanceAdjustment adjustment;
   const float edge=GameplayProfile{}.balance(PhysicalBalanceKind::manual).endpoint;
   adjustment.lean_multiplier=0;adjustment.lean_add_signed=(safe?(nose?1.f:-1.f):(nose?-1.f:1.f))*edge*1.01f;
   adjustment.speed_multiplier=0;
   check(physical_manual.adjust(adjustment),"endpoint fixture adjusts actual production dynamics");
   tick(dt,100,wanted);remap();
   check((safe?combo_session.manual_putdown():combo_session.failed_section())&&!remap().manual.owns,
       "genuine integrated endpoint retains native safe-putdown or bail request");
  }
 }
}
void episode_airborne_combos(){
 for(unsigned hz:{30u,60u,120u})for(bool nose:{false,true})for(unsigned duration:{300u,800u}){
  const unsigned dt=1000/hz;const auto wanted=nose?0x8000u:0x4000u;
  qualified(nose,dt,300);const auto multiplier=combo_session.model().state().multiplier;
  const auto serial=manual_episode.serial();
  const auto setup=remap(0x1000);check(setup.jump.setup_started,"manual Ollie uses existing native setup");
  tick(dt,103,0xc000);remap(0x1000);tick(dt,103,0xc000);
  check(remap().jump.released,"manual Ollie uses physical release without synthesizing an edge");
  const auto start=clock_ms;tick(dt,200,0);remap();
  while(clock_ms-start<duration){tick(dt,200,0);remap();
   check(combo_session.model().state().combo_active&&!balance_hud_pending()&&
       combo_session.model().state().multiplier==multiplier&&!manual_release.pending(),
       "short and long native flight retain airborne combo without fictional manual HUD or multiplier");}
  tick(dt,200,0);remap(nose?2u:1u);tick(dt,200,0);remap(nose?1u:2u);
  rows.push_back({80,90,nose?2u:1u});tick(dt,100,wanted);remap();
  check(manual_balance_admitted.load()&&balance_hud_pending()&&combo_session.model().state().combo_active,
      "fresh airborne preparation lands into manual while retaining combo");
  if(duration<500)check(manual_episode.serial()==serial,"short hop retains original manual episode");
 }
}
void episode_suspension(){
 for(bool nose:{false,true}){
  const auto wanted=nose?0x8000u:0x4000u;qualified(nose,17,300);
  const auto id=manual_episode.serial();const auto before=snapshot().elapsed;
  clock_ms+=17;observe(.017f,0,100,false);client(.017f,{});remap();
  check(manual_episode.serial()==id&&balance_hud_pending()&&snapshot().elapsed==before&&!manual_release.pending(),
      "failed native read suspends dynamics and actuator without erasing HUD or requesting exit");
  clock_ms+=17;observe(.017f,wanted);client(.017f,history());const auto resumed=remap();
  check(resumed.manual.owns&&manual_episode.serial()==id&&balance_hud_pending()&&!manual_release.pending(),
      "same verified native owner/contact resumes retained pressure after short read failure");
  const auto original=latest.sampled_at;clock_ms+=25;client(.017f,history());
  check(observed.sampled_at_ms==original,"client publication retains the original native HUD timestamp");
  set_enabled(false,false);
  check(!observed.valid,"actual OFF callback clears the HUD publication source immediately");
 }
}
void episode_buffered_endpoint(){
 for(bool nose:{false,true}){
  const auto wanted=nose?0x8000u:0x4000u;qualified(nose,17,300);
  ManualBalanceAdjustment a;a.lean_multiplier=0;a.lean_add_signed=(nose?1.f:-1.f)*100000.f;a.speed_multiplier=0;
  check(physical_manual.adjust(a),"endpoint uses actual physical balance");tick(17,100,wanted);remap();
  check(manual_release.pending(),"integrated safe endpoint starts actual release adapter");
  clock_ms+=17;observe(.017f,0xc000);clock_ms+=17;observe(.017f,wanted);client(.017f,history());remap();
  check(!manual_release.pending(),"original observed physical completion between clients must retire old pending release before recovery contact");
 }
}
int main(){
#if defined(DINGOSDK_MANUAL_LIFECYCLE_HUD)
 ImGui::CreateContext();auto& io=ImGui::GetIO();io.IniFilename=nullptr;io.LogFilename=nullptr;
 io.DisplaySize=ImVec2(1280,800);unsigned char* pixels{};int width{},height{};
 io.Fonts->GetTexDataAsRGBA32(&pixels,&width,&height);
#endif
 episode_ground_gap_regression();
 camera_client_phase();
#if defined(DINGOSDK_INPUT_PHASE_ONLY)
 std::cout<<checks<<" source-composed client phase and camera checks passed\n";return 0;
#endif
 episode_ten_seconds();
 analog_manual_entry_tolerance();
 manual_handoff_native_boundaries();
 manual_revert_production();
 manual_revert_contact_publication_gap();
 manual_revert_without_native_transition();
 manual_pressure_observation_gaps();
 manual_observation_continuity();
 analog_air_boundaries();analog_air_lifecycle();air_admission_lifecycle();
 episode_airborne_combos();episode_real_exits();episode_suspension();episode_buffered_endpoint();
 camera_lifecycle();camera_routing_lifecycle();camera_diagnostic_lock_outcomes();controller_packet_dependencies();
 std::cout<<checks<<" production-composed manual episode checks passed\n";
}
